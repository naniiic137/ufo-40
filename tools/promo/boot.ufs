# Promo: the console boots and the saucer beams the logo down. The hook and
# the end card are both cut from it (tools/promo/fx.c writes their words
# over it). The boot jingle is muted: the montage track plays from frame 0.
audio on
volume 0 10
record_start boot
wav_start boot
wait 420
record_stop
wav_stop
