# Promo tile: slot 26 (SKIDKIDS) for the games grid, made from
# tools/shots/26_skidkids.ufs: its set-up, then 240 frames of its GIF's play
seed 26
game skidkids
wait 40
press A
wait 10
press A
wait 20
press A
wait 90
press A
wait 30
botuntil state == 5 2000
wait 30
botuntil state == 7 2000
botplay 700
record_start 26
botplay 240
record_stop
