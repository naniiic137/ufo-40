# README media: DUKES UP. Everything in play is the demo player's real
# button presses (ROOK, no continues). The GIF is a stretch of night 1 on
# Market Street; the stills are the title, the fighter select, the corner
# shop, the orchard, the penthouse and the gym.
shotscale 2
seed 1
game dukesup
wait 40
shot dukesup_title
press A
wait 30
press A
wait 20
press RIGHT
wait 30
shot dukesup_select
press LEFT
wait 2
botuntil state == 4 600
botuntil cam >= 300 20000
gifstart dukesup 3 1
botplay 600
gifstop
# the corner shop after night 1
botuntil state == 6 30000
wait 20
shot dukesup_shop
# night 3: the old orchard
botuntil night == 3 60000
botuntil cam >= 380 30000
botplay 120
shot dukesup_orchard
# night 5: the penthouse
botuntil night == 5 60000
botuntil sec == 3 60000
botplay 240
shot dukesup_grist
botuntil state == 9 60000
wait 200
shot dukesup_ending
# the gym
cheat botplan 1
botuntil state == 0 4000
botuntil gym == 1 4000
botuntil gym_wave == 4 30000
botplay 300
shot dukesup_gym
cheat botplan 0
