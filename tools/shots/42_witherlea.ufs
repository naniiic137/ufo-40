# README media: WITHERLEA. The GIF is the demo player's real button presses:
# out of the cold store (a nail under the hinge pins) and into the house. The stills set up a moment with
# cheats and show it.
shotscale 2
seed 42
game witherlea
wait 60
press A
wait 40
shot witherlea_title
cheat bot 1
botuntil scene == 3 600
botplay 20
gifstart witherlea 3 1
botplay 840
gifstop
cheat bot_off
# the Keeper in the parlour, close
cheat new
cheat spawn 99999
cheat room parlour
cheat keeper
wait 170
cheat cursor 100 110
wait 2
shot witherlea_keeper
# the breathing game in the kitchen pantry
cheat new
cheat spawn 99999
cheat room kitchen
cheat keeper
wait 2
cheat aim S_KIT_PANTRY
press A
waituntil mini_pause == 0 100
wait 40
shot witherlea_hide
# the landing by lamplight
cheat new
cheat spawn 99999
cheat set F_STAIRS_LIT
cheat room landing
cheat cursor 128 62
wait 2
shot witherlea_landing
# the back garden, and the bag with the magnet held over the fishing line
cheat new
cheat spawn 99999
cheat room garden
cheat give magnet
cheat give line
cheat give knife
cheat pages 1027
cheat give lamp
cheat give brassbee
cheat cursor 160 104
wait 2
shot witherlea_garden
cheat hold magnet
press B
press RIGHT
wait 2
shot witherlea_bag
# a diary page
press B
cheat hold none
press B
press RIGHT
press RIGHT
press RIGHT
press A
wait 4
shot witherlea_diary
