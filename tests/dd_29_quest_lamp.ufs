# DOT & DASH: the lamps. In Glimmer, on the reading lamp's shade, a pilgrim
# by the flashing beacon tells of the pilgrimage. The ferry fly from the end
# of the shade carries Dot up to the great lamp hanging from the ceiling; at
# its far end she shrinks and climbs inside its rim to the Glow. Back in
# Glimmer the High Lumen names her a Lumen and hands her a scroll, and the
# Wick Warden turns the reading lamp off: the Old Filament wakes and gives a
# hint about the keyhole, and 80 glints for the Big Bang, carried unbroken
# from the far end of the SIEGE box. Weepy pays 15 for her blue thread.
game dotdash
wait 5
cheat newgame
cheat no_foes
cheat nodash
cheat god
cheat up tonic1
cheat up mitt1
cheat area 0 124 83
cheat nodash
wait 5
# the blue thread on the spool on top of the bookshelf, for later
cheat bot_to obj:36
botuntil bot_state == 2 12000
press B
wait 20
expect carry == 36
cheat up satchel1
cheat skip_dialog
hold DOWN A 3
wait 3
expect satchel0 == 36
# over to the reading lamp at the end of the hanging shelf
cheat area 0 84 19
cheat nodash
wait 5
cheat bot_tile 91 21
botuntil bot_state == 2 12000
expect ty == 21
hold DOWN 100
waituntil trans == 0 60
expect town == 17
cheat bot_to npc:3
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.pilgrim == 1
cheat bot_to npc:37
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.lumen == 0
# back up to small size and onto the ferry at the end of the shade
cheat bot_free
botuntil bot_state == 2 600
hold UP 100
waituntil trans == 0 60
expect scale == 1
cheat bot_tile 94 21
botuntil bot_state == 2 3000
waituntil ferry1_state == 0 2000
cheat tile 96 19
waituntil riding == 327 60
waituntil ferry1_state == 4 1500
expect riding == 327
expect ty == 17
# off onto the great lamp, to its far end, and smaller
hold LEFT 12
wait 20
expect ty == 17
cheat bot_to door:22
botuntil bot_state == 2 2000
hold DOWN 100
waituntil trans == 0 60
expect level_kind == 2
expect level_id == 4
cheat bot_to npc:56
botuntil bot_state == 2 12000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.shrine == 1
# the long way down is a long fall: grow instead, and ride back
cheat bot_free
botuntil bot_state == 2 600
hold UP 100
waituntil trans == 0 60
expect scale == 1
expect ty == 17
waituntil ferry1_state == 4 3000
cheat tile 116 14
waituntil riding == 327 60
waituntil ferry1_state == 0 1500
hold LEFT 12
wait 20
expect ty == 21
cheat bot_tile 91 21
botuntil bot_state == 2 600
hold DOWN 100
waituntil trans == 0 60
expect town == 17
cheat bot_to npc:37
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.lumen == 1
expect objs_27 == 1
cheat bot_to npc:38
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect asking == 1
press LEFT
press A
wait 5
expect flag.lamp_off == 1
expect lamp_dark == 1
cheat skip_dialog
# the Old Filament speaks on the dark shade: only a hint
cheat bot_free
botuntil bot_state == 2 600
hold UP 100
waituntil trans == 0 60
expect npcs_5 == 1
cheat bot_to npc:5
botuntil bot_state == 2 2000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.filament_asked == 1
expect flag.met_nib == 0
# Weepy on the east pot's rim takes the thread
cheat area 0 124 83
cheat nodash
wait 5
hold DOWN A 3
wait 3
expect carry == 36
cheat bot_to npc:12
botuntil bot_state == 2 6000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.weepy_done == 1
# into the SIEGE box, past the tanks and planes to the far end
cheat bot_to door:8
botuntil bot_state == 2 9000
press UP
waituntil level_id == 4 60
waituntil trans == 0 60
expect objs_39 == 1
cheat bot_to obj:39
botuntil bot_state == 2 12000
press B
wait 20
expect carry == 39
hold DOWN A 3
wait 3
expect satchel0 == 39
# back out and up to the reading lamp with it, safe in the satchel
cheat bot_to door:9
botuntil bot_state == 2 12000
press UP
waituntil level_id == 0 60
waituntil trans == 0 60
cheat bot_to npc:5
botuntil bot_state == 2 12000
hold DOWN A 3
wait 3
expect carry == 39
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.bigbang_done == 1
expect glints >= 80
