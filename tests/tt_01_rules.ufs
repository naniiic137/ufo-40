# TIN TROOP: the levels are well formed; the troop starts 1-A with 20.
# Soldiers parachute in, safe until they land or A cuts them loose. Each
# ritual spends one soldier, and a chain of rituals still costs one.
game tintroop
wait 5
expect level_errors == 0
expect state == 0
press A
wait 5
expect state == 1
press A
wait 5
expect state == 2
wait 30
press A
wait 5
expect state == 3
expect lives == 20
expect mode == 1
# a mouse can't touch a soldier on his chute
cheat foe mouse 26 60
wait 20
expect mode == 1
expect lives == 20
cheat no_foes
# A cuts him loose: he drops
press A
expect mode == 3
wait 60
expect ground == 1
expect lives == 20
# the Lance (B alone): he flies until a wall stops him and stays as a ledge
hold LEFT 8
press B
expect lives == 19
wait 20
expect count_lodged == 1
expect body_0_x < 12
# the Pop (up + B) leaves nothing behind
cheat pos 100 121
wait 10
press UP+B
expect lives == 18
expect count_lodged == 1
expect count_stone == 0
expect count_corpse == 0
# the Lead (down + B) on the ground: he stands a moment, then he's a stone
cheat pos 100 121
wait 10
press DOWN+B
expect lives == 17
expect mode == 8
wait 22
expect count_stone == 1
expect stone_y == 120
# in the air, a stone at once, falling at full speed
cheat pos 170 121
wait 10
hold A 12
press DOWN+B
expect lives == 16
expect mode == 7
wait 12
expect count_stone == 2
# chains, one soldier each: lance then stone...
cheat pos 70 121
wait 10
hold A 12
hold A+LEFT 1
press B
press DOWN+B
expect lives == 15
expect mode == 7
wait 30
expect count_stone == 3
# ...a falling stone that flies off as a lance...
cheat pos 130 121
wait 10
hold A 12
press DOWN+B
hold LEFT 1
press B
expect mode == 6
expect lives == 14
wait 30
expect count_lodged == 2
# ...and a falling stone that goes off
cheat pos 130 121
wait 10
hold A 12
press DOWN+B
press UP+B
expect lives == 13
expect count_stone == 3
