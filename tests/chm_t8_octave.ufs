# CHIME CIRCUIT: track 8 can be finished. The demo pilot flies player one's
# ship with real button presses (steer, thrust, slash) for all eight laps,
# against the five CPU pilots, who race too.
seed 18
game chime
wait 30
cheat race 8
expect track == 7
expect map_ok == 1
botuntil fin0 == 1 30000
expect laps0 == 8
expect place0 >= 1
expect cpu_laps >= 8
# The finale's crossing and top loop are wide enough that a ship on its
# own flies it clean: the demo pilot, and a CPU pilot too.
cheat race 8
cheat park_cpus
botuntil fin0 == 1 30000
expect walls0 == 0
expect wrecks0 == 0
cheat race 8
cheat park 0
cheat park 2
cheat park 3
cheat park 4
cheat park 5
waituntil fin1 == 1 30000
expect walls1 <= 1
expect wrecks1 == 0
