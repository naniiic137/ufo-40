# CLARION CALL: the things behind the doors, region by region. A dropper
# hangs from the ceiling and drops when Clary passes under; a wisp nest
# keeps sending wisps (three at a time) while it is on screen; a louse
# dies to one shot; a brute takes six and leaves 60 coins; a ringworm
# throws a ring of six; a pelter lobs rocks; a trooper fires along the
# floor; a cocoon lets out bees; a spitter spits fire that spreads along
# the floor; a jet's fire wall comes and goes; a fire wheel turns over the
# path (walkable under, not to jump through). On the Icehouse's ice Clary
# slides.
seed 1
game clarion
wait 10
cheat area 5 0
wait 2
cheat enter_room 10
wait 50
# the dropper
cheat sub_ent 31 160 40
cheat sub_place 120 144
hold RIGHT 30
waituntil ent_flag0 > 0 60
cheat sub_kill 31
# a wisp nest
cheat sub_ent 44 200 80
wait 160
expect count45 == 3
cheat sub_kill 44
cheat sub_kill 45
# a louse: one shot
cheat sub_place 100 144
cheat face 1
cheat sub_ent 32 150 144
wait 2
press B 1
wait 20
expect count32 == 0
# a brute: six shots, 60 coins
cheat coins 0
cheat hp 32
cheat give 16
cheat give 16
cheat give 16
cheat give 16
cheat give 16
cheat give 16
cheat give 16
cheat give 16
cheat sub_place 60 144
cheat face 1
cheat sub_ent 34 200 144
wait 2
press B 1
wait 6
press B 1
wait 6
press B 1
wait 6
press B 1
wait 6
press B 1
wait 6
press B 1
wait 6
press B 1
wait 6
press B 1
wait 30
expect count34 == 0
expect coins == 60
# a ringworm's ring, a pelter's rock, a trooper's shots, a spitter's fire
cheat clear_shots
cheat sub_place 60 144
cheat sub_ent 35 200 144
waituntil shotk11 == 6 130
cheat sub_kill 35
cheat clear_shots
cheat sub_ent 37 200 144
waituntil shotk12 > 0 110
cheat sub_kill 37
cheat clear_shots
cheat sub_ent 39 200 144
waituntil shotk7 > 0 200
cheat sub_kill 39
cheat clear_shots
cheat sub_ent 42 200 144
waituntil shotk15 > 0 120
cheat sub_kill 42
cheat clear_shots
# a cocoon's bees
cheat sub_ent 40 200 40
waituntil count41 > 0 160
cheat sub_kill 40
cheat sub_kill 41
# a jet's fire wall
cheat hp 32
wait 70
cheat sub_place 120 144
cheat sub_ent 33 120 144
waituntil hp < 32 200
cheat sub_kill 33
# the Icehouse: sliding on ice
cheat area 2 0
wait 2
cheat enter_room 0
wait 40
cheat no_foes
hold RIGHT 30
wait 10
expect sub_vx > 150
