# DOT & DASH: a route test for the lumber room. From the rug, small, the
# demo player walks and jumps (real presses) to every part of the room in
# turn: the thimble, into the west pot and up its plant, the hanging shelf,
# the clock and the portrait, the money box, the outlets, the east pot, the
# dust pile under the bookshelf, up through all four compartments to the
# top, the spool and the lamp.
game dotdash
wait 5
cheat newgame
cheat no_foes
cheat nodash
cheat god
hold DOWN 100
waituntil trans == 0 60
expect scale == 1
# thimble door
cheat bot_to door:0
botuntil bot_state == 2 9000
expect bot_state == 2
# west pot soil
cheat bot_tile 47 65
botuntil bot_state == 2 9000
expect bot_state == 2
# plant top
cheat bot_tile 46 29
botuntil bot_state == 2 9000
expect bot_state == 2
# hanging shelf
cheat bot_tile 57 29
botuntil bot_state == 2 9000
expect bot_state == 2
# clock top
cheat bot_tile 64 16
botuntil bot_state == 2 9000
expect bot_state == 2
# portrait top
cheat bot_tile 84 19
botuntil bot_state == 2 9000
expect bot_state == 2
# money box top
cheat bot_tile 65 72
botuntil bot_state == 2 9000
expect bot_state == 2
# west outlet
cheat bot_to door:2
botuntil bot_state == 2 9000
expect bot_state == 2
# east pot soil
cheat bot_tile 112 66
botuntil bot_state == 2 9000
expect bot_state == 2
# east rim
cheat bot_tile 120 62
botuntil bot_state == 2 9000
expect bot_state == 2
# dust pile
cheat bot_tile 136 79
botuntil bot_state == 2 9000
expect bot_state == 2
# fluff hollow door
cheat bot_to door:6
botuntil bot_state == 2 9000
expect bot_state == 2
# train
cheat bot_tile 138 70
botuntil bot_state == 2 9000
expect bot_state == 2
# stone owl
cheat bot_tile 148 63
botuntil bot_state == 2 9000
expect bot_state == 2
# books
cheat bot_tile 130 44
botuntil bot_state == 2 9000
expect bot_state == 2
# siege box
cheat bot_to door:8
botuntil bot_state == 2 9000
expect bot_state == 2
# top books
cheat bot_tile 130 13
botuntil bot_state == 2 9000
expect bot_state == 2
# bookshelf top
cheat bot_tile 126 9
botuntil bot_state == 2 9000
expect bot_state == 2
# spool
cheat bot_tile 147 5
botuntil bot_state == 2 9000
expect bot_state == 2
# lamp shade
cheat bot_tile 116 17
botuntil bot_state == 2 9000
expect bot_state == 2
# every spot of the room is reachable from the rug
cheat area 0 30 82
wait 5
expect reach.17_82 == 1
expect reach.64_16 == 1
expect reach.147_5 == 1
expect reach.116_17 == 1
expect reach.153_83 == 1
