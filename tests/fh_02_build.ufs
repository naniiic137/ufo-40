# FLINTHOLD: A on open ground offers a thrower, a hen and a fire pit (and,
# between waves, the horn; always LEAVE STAGE); the cost comes off the meat.
# Nothing goes next to the path, B closes the menu, and a line you can't pay
# for does nothing.
game flinthold
wait 5
cheat stage 1
expect meat == 30
# face the open tile (8,4) from above
cheat pim 8 3 1
wait 1
press A
expect menu_open == 1
expect menu_n == 5
expect menu0 == 0
expect menu1 == 1
expect menu2 == 2
expect menu3 == 7
expect menu4 == 10
press A
expect menu_open == 0
expect obj_8_4 == 1
expect kind_8_4 == 0
expect units == 1
expect meat == 20
# a hen on the next tile: DOWN once, then A
cheat pim 9 3 1
wait 1
press A
press DOWN
expect cursor == 1
press A
expect obj_9_4 == 2
expect cook_9_4 == 0
expect meat == 10
# next to the path: nothing to build, only the horn and LEAVE STAGE
expect build_7_2 == 0
cheat pim 7 3 3
wait 1
press A
expect menu_open == 1
expect menu_n == 2
expect menu0 == 7
expect menu1 == 10
press B
expect menu_open == 0
# B closes a menu without buying
cheat pim 4 4 1
wait 1
press A
expect menu_open == 1
press B
expect menu_open == 0
expect meat == 10
# too little meat: the line is there but does nothing
cheat meat 5
press A
press A
expect obj_4_5 == 0
expect meat == 5
