press A
hold UP 70
hold A 12
wait 1
waituntil bphase == 2 400
hold DOWN 70
hold A 12
wait 1
waituntil bside == 1 400
waituntil bphase == 1 60
# turn 8
press A
hold UP 70
hold A 12
wait 1
waituntil bphase == 2 400
hold DOWN 70
hold A 12
wait 1
waituntil bside == 0 400
waituntil bphase == 1 60
# turn 9
press A
hold UP 70
hold A 12
wait 1
waituntil bphase == 2 400
hold DOWN 70
hold A 12
wait 1
waituntil bside == 1 400
waituntil bphase == 1 60
# turn 10
press A
hold UP 70
hold A 12
wait 1
waituntil bphase == 2 400
hold DOWN 70
hold A 12
wait 1
waituntil bphase == 6 400
expect bwinner == 3
expect fog_deaths == 0
wait 80
press A
wait 2
expect state == 4
expect athome0 == 1
expect athome1 == 1
expect army1 == 1
expect reserve1 == 2
expect turn == 1
