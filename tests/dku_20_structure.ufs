# DUKES UP, the full scale: four fighters with the original's stat spreads
# (ROOK 2 1 2 2, PIP 1 3 1 2, MACK 3 1 1 1, DOLLY 1 1 2 3: POWER, RECOV,
# TOUGH, THROW), five fixed nights with a boss each (Big Ram, the Boar
# Baron, the two Visitors, the Undertow, Alderman Grist), twelve kinds of
# ghoul, a five-wave lift before the two-form final boss, a heal for $5 and
# a stat for $20.
game dukesup
wait 5
expect n_nights == 5
expect secs_1 == 2
expect secs_2 == 3
expect secs_3 == 3
expect secs_4 == 3
expect secs_5 == 4
expect boss_of_1 == 4
expect boss_of_2 == 6
expect boss_of_3 == 8
expect boss_of_4 == 13
expect boss_of_5 == 14
expect enemy_kinds == 12
expect lift_waves == 5
expect price_heal == 5
expect price_stat == 20
expect fighter_0_0 == 2
expect fighter_0_1 == 1
expect fighter_0_2 == 2
expect fighter_0_3 == 2
expect fighter_1_0 == 1
expect fighter_1_1 == 3
expect fighter_1_2 == 1
expect fighter_1_3 == 2
expect fighter_2_0 == 3
expect fighter_2_1 == 1
expect fighter_2_2 == 1
expect fighter_2_3 == 1
expect fighter_3_0 == 1
expect fighter_3_1 == 1
expect fighter_3_2 == 2
expect fighter_3_3 == 3
# every screen's words fit
expect layout == 0
