# CLARION CALL: the Clarion sets down on a level floor when it comes down
# slowly (under 0.75 px a frame) and nearly straight (under 0.63 across),
# and Clary hops out beside it; the safe-landing mark shows on the floor
# below while it is over somewhere that would take it. Any floor contact
# faster than that which isn't a landing costs a point (and a bounce).
# A grey landing pad takes a little more (1 px a frame down, 0.8
# across). Walls and ceilings bounce the ship back and hurt (a point)
# when hit at over 0.4 px a frame. The bar is one bar in half points:
# 8 points = 16. (Between the checks the Crown is entered afresh, so
# that no bounce or grace time carries over.)
seed 1
game clarion
wait 10
cheat area 6 2
wait 2
# the mark, from high above the floor
cheat place 100 200
cheat vel 0 0
wait 1
expect landing_icon == 31
# a gentle landing (a 2 px drop: falling free for a tile is already too fast)
cheat place 100 242
cheat vel 0 0
wait 20
expect on_foot == 1
expect ship == 1
expect hp == 16
expect ship_y == 244
expect x == 111
# a bad landing: a long fall
cheat place 100 130
cheat vel 0 0
waituntil hp < 16 120
expect hp == 14
expect on_foot == 0
expect vy < 0
wait 60
cheat area 6 2
wait 2
# sliding in too fast to set down: that costs a point too
cheat hp 16
cheat place 100 243
cheat vel 300 60
waituntil hp < 16 20
expect on_foot == 0
expect hp == 14
wait 60
cheat area 6 2
wait 2
# coming down at 0.9 px a frame: a bad landing on rock ...
cheat hp 16
cheat place 100 242
cheat vel 0 180
waituntil hp < 16 20
expect on_foot == 0
expect hp == 14
wait 60
cheat area 6 2
wait 2
# ... and a landing on a pad
cheat tile 11 31 10
cheat tile 12 31 10
cheat tile 13 31 10
cheat hp 16
cheat place 100 242
cheat vel 0 180
wait 20
expect on_foot == 1
expect hp == 16
# a wall hit hard
cheat place 165 225
cheat vel 400 0
waituntil vx < 0 40
expect hp == 14
expect ship_inv > 0
wait 60
cheat area 6 2
wait 2
# a wall hit at 0.8 px a frame: that hurts too now
cheat hp 16
cheat place 165 225
cheat vel 200 0
waituntil vx < 0 40
expect hp == 14
wait 60
cheat area 6 2
wait 2
# a wall touched gently (under 0.4 px a frame)
cheat hp 16
cheat place 169 225
cheat vel 90 0
waituntil vx <= 0 20
expect hp == 16
wait 60
cheat area 6 2
wait 2
# the ceiling, hard
cheat place 100 130
cheat vel 0 -440
waituntil vy > 0 30
expect hp == 14
