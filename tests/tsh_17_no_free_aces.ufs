# TILTSHOT design test: no free holes in one. On every hole but Toss-Up,
# the par 1, no tee shot without a slam drops in: every aim (37) at every
# strength (0 to 60 frames of A) is played from the tee on the course with
# nothing moving, and from every point where the ball could meet a mover it
# is played on as if it had struck it (a mover keeps a fifth of the speed);
# on holes with movers the whole sweep is also played on the real course at
# four start times spread through the movers' round. The holes in one the
# guides describe are there, and each needs its slam: Opening Tee (a slam
# onto the mound's far side), Double Spring (a slam after the springs),
# Pebble (a slam to hop the last of the junk) and Bounce House's very
# precise one, not at full power.
seed 17
game tiltshot
wait 5
cheat sweep 1 4
expect sweep_in == 0
expect sweep_n > 2000
cheat sweep 2 4
expect sweep_in == 0
expect sweep_n > 9000
cheat sweep 3 4
expect sweep_in == 0
cheat sweep 4 4
expect sweep_in == 0
cheat sweep 5 4
expect sweep_in == 0
cheat sweep 6 4
expect sweep_in == 0
cheat sweep 7 4
expect sweep_in == 0
cheat sweep 8 4
expect sweep_in == 0
cheat sweep 10 4
expect sweep_in == 0
cheat sweep 11 4
expect sweep_in == 0
cheat sweep 12 4
expect sweep_in == 0
cheat sweep 13 4
expect sweep_in == 0
cheat sweep 14 4
expect sweep_in == 0
cheat sweep 15 4
expect sweep_in == 0
cheat sweep 16 4
expect sweep_in == 0
cheat sweep 17 4
expect sweep_in == 0
cheat sweep 18 4
expect sweep_in == 0
# Toss-Up is the one hole where a plain full shot can go in
cheat sweep 9 0
expect sweep_in > 0
# the slammed holes in one: in with the slam, not in without it
cheat play 1 3 60 98
expect play_in == 1
cheat play 1 3 60 -1
expect play_in == 0
cheat play 10 2 56 104
expect play_in == 1
cheat play 10 2 56 -1
expect play_in == 0
cheat play 11 3 59 74
expect play_in == 1
cheat play 11 3 59 -1
expect play_in == 0
cheat play 3 8 48 51
expect play_in == 1
cheat play 3 8 48 -1
expect play_in == 0
# a few frames either side of the slam and they miss
cheat play 1 3 60 92
expect play_in == 0
cheat play 11 3 59 68
expect play_in == 0
cheat play 3 8 48 45
expect play_in == 0
