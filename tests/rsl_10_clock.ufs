# RESTLESS: 150 seconds on the clock for each half; a clock adds 30; at
# nothing, clockfires (5 HP) keep coming from the edges. From six deaths
# the clock runs twice as fast. At the end of a half, the seconds left to
# the nearest five, times 50, are the bonus.
game restless
wait 5
cheat half 0
cheat nospawn
cheat god
expect time == 150
wait 60
expect time == 149
cheat deaths 6
wait 60
expect time == 147
cheat deaths 1
cheat item 7 72 130
wait 12
expect time == 177
cheat time 1
wait 70
expect time == 0
cheat spawn
waituntil foes_18 >= 1 120
expect foes_18 >= 1
cheat timeframes 3780
cheat score 0
cheat tally
wait 2
expect state == 6
expect tally_bonus == 3250
expect score == 3250
