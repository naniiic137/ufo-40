# WITHERLEA: four stone hares, four gems for their eyes. The plaque gives
# the order (the sun, the leaf, the blood, the moon: amber, jade, garnet,
# opal). The wrong order and all four drop out again; the right one opens
# the gate to the hedges. A gem can be taken back out of an eye.
game witherlea
wait 5
cheat new
cheat spawn 99999
cheat give garnet
cheat give jade
cheat give amber
cheat give opal
cheat room courtyard
cheat aim S_CRT_PLAQUE
press A
expect talking == 1
cheat hush
# garnet first: wrong
cheat hold garnet
cheat aim S_CRT_HARE0
press A
expect hare0 == 35
expect has_garnet == 0
cheat hush
# take it back out
press A
expect hare0 == 0
expect has_garnet == 1
cheat hush
cheat hold garnet
press A
cheat hush
cheat hold jade
cheat aim S_CRT_HARE1
press A
cheat hush
cheat hold amber
cheat aim S_CRT_HARE2
press A
cheat hush
cheat hold opal
cheat aim S_CRT_HARE3
press A
expect hare0 == 0
expect hare3 == 0
expect has_garnet == 1
expect has_opal == 1
expect flag_F_GATE_OPEN == 0
expect live_S_CRT_MAZE == 0
cheat hush
# the right order
cheat hold amber
cheat aim S_CRT_HARE0
press A
cheat hush
cheat hold jade
cheat aim S_CRT_HARE1
press A
cheat hush
cheat hold garnet
cheat aim S_CRT_HARE2
press A
cheat hush
cheat hold opal
cheat aim S_CRT_HARE3
press A
expect flag_F_GATE_OPEN == 1
expect live_S_CRT_MAZE == 1
expect hare0 == 51
expect hare3 == 43
expect has_amber == 0
