# GRUB SHIFT: buying SEED, then dropping a third pod on a tile blows it into
# a sinkhole and blasts the tiles around it.
game grubshift
wait 5
cheat contract 1 7
cheat clear
cheat shop 0 24
cheat energy 2
cheat buy 0 3
expect chip3 == 24
expect energy == 0
cheat pods 4 0 2
cheat bug 5 0 3 0
cheat use 3 4 0
expect hole_at40 == 1
expect kills == 1
expect status == 0
