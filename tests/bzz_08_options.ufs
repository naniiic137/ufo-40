# BUZZBOLT: ZZZ brings an option, two at most (a third ZZZ patches both
# up). Options soak up shots and break after enough of them, and each
# ship's option does its own thing: the lacewing's rushes out at foes
# while fire is held, the shieldbug's moves in front as a shield, the
# firefly's fires homing rockets, but only while fire is held.
game buzzbolt
press A
wait 10
press A
cheat quiet
wait 130
cheat pos 160 150
cheat word 2
expect nopt == 1
expect opt0_hp == 10
cheat word 2
expect nopt == 2
wait 20
expect opt0_dx == -14
# a shot into an option: it soaks it up
cheat eshot 0 146 120 0 2
wait 25
expect opt0_hp == 9
expect alive == 1
expect eshots == 0
# a third ZZZ: still two, mended
cheat word 2
expect nopt == 2
expect opt0_hp == 10
# ten shots at once break it
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
cheat eshot 0 146 120 0 2
wait 25
expect nopt == 1
expect alive == 1
# the lacewing's: fire held, it rushes the nearest foe and fights it
cheat dummy 1 60 50
wait 10
hold A 60
expect opt0_dx < -70
expect opt0_dy < -70
expect foe0_hp < 220
wait 40
expect opt0_dy > 0
# the shieldbug's: in front while fire is held, beside while tapping
game buzzbolt
press A
wait 10
press RIGHT
press A
cheat quiet
wait 130
cheat pos 160 150
cheat word 2
expect opt0_hp == 24
wait 10
expect opt0_dy > 0
hold A
wait 30
expect opt0_dy < -10
expect opt0_dx > -10
cheat eshot 0 153 90 0 2
wait 30
release A
expect alive == 1
expect opt0_hp == 23
press A
wait 20
expect opt0_dy > 0
# the firefly's: nothing while tapping, homing rockets while holding
game buzzbolt
press A
wait 10
press LEFT
press A
cheat quiet
wait 130
cheat pos 160 150
cheat word 2
expect opt0_hp == 8
cheat dummy 1 60 50
press A
wait 3
press A
wait 3
press A
expect pshots_4 == 0
wait 30
hold A 40
expect pshots_4 > 0
