# SKID KIDS: nobody can keep a bag for ever: after five seconds in hand it
# throws itself (a wind-up in progress goes as it is).
game skidkids
wait 5
cheat match 0 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 60 100
cheat give 0 1
wait 290
expect held0 == 1
expect n_forced == 0
wait 15
expect held0 == 0
expect n_forced == 1
expect n_throw == 1
# winding up doesn't stop the clock
cheat clearbags
cheat give 0 1
cheat hold 0 250
hold B 60
wait 1
expect n_forced == 2
expect held0 == 0
