# SKID KIDS: secrets of our own. On the 2P VERSUS draft, player 2 holding UP
# for thirty seconds finds a note under the bleachers. Some pairs of kids
# have a word for each other before a match.
seed 26
game skidkids
wait 20
press DOWN
press DOWN
press A
wait 10
press A
wait 12
expect state == 2
expect note == 0
hold P2UP 1820
expect note == 1
# SID on your team against BUZZY's: an exchange
cheat tourney 9 0
cheat round 0
cheat opp 0 3 10
wait 25
press A
wait 5
expect state == 6
expect talk_n == 3
# ROXIE against KIKI
cheat tourney 7 0
cheat opp 0 6 1
cheat round 0
wait 25
press A
wait 5
expect talk_n == 3
# nothing special between NOODLE's team and MILO's
cheat tourney 0 1
cheat opp 0 3 2
cheat round 0
wait 25
press A
wait 5
expect talk_n == 1
