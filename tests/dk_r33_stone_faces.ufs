hold LEFT+A 16
hold A 22
hold LEFT+A 7
hold LEFT 27
wait 10
hold A 5
hold LEFT+A 16
wait 4
hold A 2
wait 2
hold A 22
wait 2
hold A 30
hold LEFT+A 16
wait 6
hold A 2
wait 2
hold A 27
wait 2
hold A 30
hold LEFT+A 16
wait 6
hold A 2
wait 2
hold A 34
hold LEFT+A 16
