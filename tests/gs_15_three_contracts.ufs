# GRUB SHIFT: three contracts in a row earns the Saucer and the Employee of
# the Month certificate.
game grubshift
wait 5
cheat contract 1 7
cheat clear
cheat kills 29
cheat bug 3 2 1 0
cheat use 5 3 2
wait 150
press A
wait 40
press A
wait 10
cheat clear
cheat kills 29
cheat bug 3 2 1 0
cheat use 5 3 2
wait 150
press A
wait 40
press A
wait 10
expect goals !& 2
cheat clear
cheat kills 29
cheat bug 3 2 1 0
cheat use 5 3 2
wait 150
expect streak == 3
expect goals & 2
expect goals !& 4
press A
wait 10
expect state == 5
