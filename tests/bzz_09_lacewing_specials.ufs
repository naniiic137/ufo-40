# BUZZBOLT: the lacewing's specials. BBB: two guard orbs circle the ship
# and soak up any number of shots; foes' bodies wear them out, three bumps
# each and an orb breaks. ZBB: the hiveship rises under where the ship is
# and beams straight up for a while.
game buzzbolt
# the opening: A skips it
press A
press A
wait 10
press A
cheat quiet
wait 130
cheat pos 160 150
cheat word 3
expect orbs == 2
# ten shots sitting on the orbs' circle: the orbs sweep them all up
cheat eshot 0 177 150 0 0
cheat eshot 0 174 160 0 0
cheat eshot 0 165 166 0 0
cheat eshot 0 155 166 0 0
cheat eshot 0 146 160 0 0
cheat eshot 0 143 150 0 0
cheat eshot 0 146 140 0 0
cheat eshot 0 155 134 0 0
cheat eshot 0 165 134 0 0
cheat eshot 0 174 140 0 0
expect eshots == 10
wait 90
expect eshots == 0
expect orbs == 2
expect alive == 1
# a tough foe's body, just out of the ship's reach: each orb bumps it
# three times (six damage a bump), then both are gone
cheat dummy 1 186 150
waituntil foe0_hp < 220 80
expect orbs == 2
wait 160
expect orbs == 0
expect foe0_hp == 184
expect alive == 1
cheat clear

# ZBB: the hiveship comes up under the ship and beams up its column
cheat dummy 1 160 40
cheat dummy 1 100 40
expect foe1_hp == 220
cheat word 4
expect hive_on == 1
cheat pos 100 150
wait 120
expect foe0_hp < 120
expect foe1_hp == 220
wait 80
expect hive_on == 0
