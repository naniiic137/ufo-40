# PETAL PARADE: letting the line go anywhere else turns the pups into
# brambles where they stand. Running into one ends the game.
game petalparade
wait 5
press A
cheat clear
cheat put pup 5 7
cheat put pup 5 6
wait 36
expect line == 2
press B
expect line == 0
expect brambles == 2
expect saved == 0
expect score == 0
cheat put bramble 5 2
wait 20
expect state == 2
