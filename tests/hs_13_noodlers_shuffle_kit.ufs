# HOMESPUN: four noodlers stand in the dungeons (in four of seven places,
# chosen per save): 10 data for 3 odds, 15 thread for 5, a tonic for 3 and
# one for 2 (each +100 s). Madame Shuffle deals six shuffled chests for 1 odd
# a go: 1 glint, 4 bars, 8 bars, 2 odds, a strip of jerky, or a driplet.
# Kit's two chests fill up again every trip; like every chest out in the
# open, each opens with ten rolls on the open's loot table.
seed 44
game homespun
wait 5
cheat newgame 113
wait 5
cheat trip 5
cheat odds 40
cheat govendor 0
cheat clearmobs
press A
expect menu == 1
press A
expect odds == 37
press B
hold DOWN 10
hold UP 10
wait 5
expect gain.data == 10
cheat govendor 1
cheat clearmobs
press A
press A
press B
expect odds == 32
hold DOWN 10
hold UP 10
wait 5
expect gain.thread == 15
cheat govendor 2
cheat clearmobs
cheat time 100
press A
press A
press B
expect odds == 29
expect time >= 199
cheat govendor 3
cheat clearmobs
cheat time 100
press A
press A
press B
expect odds == 27
expect time >= 199
# Shuffle's chests: one go for one odd
cheat gokind 4 168 72
cheat face 0 -1
press A
expect menu == 1
expect menu_n == 1
press A
expect odds == 26
expect gamble == 1
expect gam_bars == 12
expect gam_meat == 1
expect gam_drip == 1
wait 100
expect gamble == 2
press RIGHT
press A
wait 60
expect gamble == 0
# Kit and her chests: ten rolls each on the open's table
cheat gokind 3 168 72
cheat face 0 -1
press A
expect talk == 1
wait 10
press A
wait 10
press A
wait 10
press A
expect talk == 0
expect items == 0
cheat at 120 104
cheat face 0 -1
press A
expect items >= 1
cheat at 200 104
cheat face 0 -1
press A
expect items >= 2
