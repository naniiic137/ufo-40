# UNDERDELVE: Burlap sells the copper pot (100), an old boot (50) and the
# tuning fork (200); the owl sells gloves (100) and the pot cheaper (50).
game underdelve
wait 15
cheat no_gloom
cheat room 2 3 211 130
cheat money 180
wait 10
press UP
wait 2
expect items & 1
expect money == 80
press UP
expect money == 80
cheat pos 243 130
wait 10
press UP
expect items & 256
expect money == 30
cheat pos 275 130
wait 10
press UP
expect items !& 2
cheat money 200
press UP
expect items & 2
expect money == 0
cheat room 2 6 99 130
cheat money 100
wait 10
press UP
expect items & 8
expect money == 0
