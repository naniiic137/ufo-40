# LOST LINKS: the finale. The altar takes the four pieces of the Star Pin
# and the gate to the sanctum opens; four plates there open the den door.
# The Brass Badger: hit it in the face and it stands (it can't be hurt
# then) and fires three volleys at where the ball is, 3 strokes each; then
# it digs to another burrow, and if six strokes pass without a hit it
# fires again. Six hits win. When strokes run low in the finale each stray
# found rolls in once with 8 more.
game lostlinks
wait 5
cheat route 61
cheat no_slicers
cheat pieces 7
cheat ball 0 37 4
cheat aim 32
hold A 18
wait 1
waituntil state == 3 300
expect placed == 0
wait 15
press A
waituntil moving == 0 300
cheat pieces 15
cheat ball 0 37 4
hold A 18
wait 1
waituntil placed == 1 300
expect opened == 1
wait 15
press A
# the sanctum plates: each lights when the ball rolls over it
cheat ball 1 30 1
cheat plates 7
expect opened == 1
cheat plates 15
expect opened == 3
# the den: the Badger wakes as the ball comes in
cheat ball 1 12 9
wait 2
expect badger == 1
expect state == 3
wait 15
press A
expect badger_hp == 6
cheat strokes 40
cheat aim 42
hold A 22
wait 1
waituntil badger == 2 300
expect badger_hp == 5
waituntil moving == 0 300
# standing, then three volleys at the ball
waituntil badger == 3 60
wait 2
expect cross == 1
cheat strokes 40
waituntil cross == 0 200
expect strokes == 37
waituntil badger == 4 400
expect strokes < 37
waituntil badger == 1 100
expect badger_spot != 0
expect badger_shots == 6
# six strokes without a hit and it stands to fire again
cheat ball 1 3 8
cheat aim 16
hold A 2
wait 1
waituntil moving == 0 300
expect badger_shots == 5
hold A 2
wait 1
waituntil moving == 0 300
hold A 2
wait 1
waituntil moving == 0 300
hold A 2
wait 1
waituntil moving == 0 300
hold A 2
wait 1
waituntil moving == 0 300
hold A 2
wait 1
expect badger == 2
# strokes low: a stray rolls in to help
cheat strokes 2
wait 2
expect strays_used == 1
expect strokes == 10
expect state == 3
wait 15
press A
# the last hit: the Saucer and (everything found) the Alien
cheat badger 1 1 0
cheat ball 1 12 9
cheat aim 42
hold A 22
wait 1
waituntil won == 1 300
expect goals & 2
expect goals & 4
expect won_all == 1
expect state == 6
