# UNDERDELVE: two more ways up to the Old Lode. The smith breaks the cracked
# wall in the loft above his camp for 500 ore; the lever in its sealed nook
# drops the slab over the trapdoor shaft.
game underdelve
wait 15
cheat no_gloom
cheat room 7 0 250 130
cheat clear_enemies
hold RIGHT 80
expect room_x == 7
cheat room 7 1 99 130
cheat money 499
wait 5
press UP
expect hammer == 0
cheat money 500
press UP
expect hammer == 1
expect money == 0
cheat room 7 0 250 130
cheat clear_enemies
hold RIGHT 80
expect room_x == 0
cheat room 1 1 195 130
cheat clear_enemies
hold UP 240
expect room_y == 1
cheat room 3 5 115 130
wait 20
press UP
expect lever == 1
cheat room 1 1 195 130
cheat clear_enemies
hold UP 240
expect room_y == 0
