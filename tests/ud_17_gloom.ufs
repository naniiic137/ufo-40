# UNDERDELVE: the Gloom moves one map cell, in a random direction, every
# time Mo changes room (the HUD map shows where it is). When it finds him it
# rises in the middle of the room and comes at him at twice his speed; it
# can't be hurt. Leaving the room at once escapes it. If it touches him,
# every lantern goes out at once: the delve is over.
game underdelve
wait 15
cheat room 1 5 30 130
cheat clear_enemies
cheat gloom_at 4 4
cheat gloom_mark
hold RIGHT 300
expect room_x == 2
expect gloom_step == 1
cheat clear_enemies
cheat gloom
wait 2
expect gloom_here == 1
expect gloom_px == 152
wait 40
expect gloom_px >= 146
wait 10
expect gloom_px <= 134
expect lanterns == 6
hold LEFT 20
expect room_x == 1
expect state == 1
expect lanterns == 6
expect gloom_here == 0
cheat clear_enemies
cheat gloom
wait 300
expect state == 3
expect lanterns == 0
expect has_save == 0
