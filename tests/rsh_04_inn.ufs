# RIMSHIRE: an inn hires out the same three disks all war, as many as you
# can pay for; with the field army full (8) a disk of your choice goes to
# the reserve (6 at most) to make room; after three visits the inn closes.
game rimshire
cheat war 1
cheat coins 0 30
cheat turn 0
press RIGHT
press A
waituntil wstate == 0 60
press RIGHT
press A
waituntil wstate == 2 60
expect visits_2_1 == 1
expect offer0 < 16
expect pick == 0
press A
expect coins0 < 30
expect army0 == 3
# the same disk again
press A
expect army0 == 4
press UP
expect pick == 3
press A
waituntil turn == 1 60
expect node_2_1 == 4
# a full field army: who goes to the reserve?
cheat army 0 SSSSSSSW
cheat reserve 0 -
cheat coins 0 30
cheat at 0 1 1
cheat turn 0
press RIGHT
press A
waituntil wstate == 2 60
expect visits_2_1 == 2
press A
expect wstate == 7
press DOWN
press DOWN
press DOWN
press DOWN
press DOWN
press DOWN
press DOWN
expect pick == 7
press A
expect wstate == 2
expect army0 == 8
expect reserve0 == 1
expect reskind0_0 == 1
# B at the question hires nobody
press A
expect wstate == 7
press B
expect wstate == 2
expect reserve0 == 1
press UP
press A
waituntil wstate == 0 60
press RIGHT
press A
waituntil turn == 1 60
# the third visit is the last
cheat at 0 1 1
cheat turn 0
press RIGHT
press A
waituntil wstate == 2 60
expect visits_2_1 == 3
press B
waituntil wstate == 0 60
press RIGHT
press A
waituntil turn == 1 60
expect node_2_1 == 1
