# FOSSIL FEUD: LEFT RIGHT RIGHT LEFT LEFT LEFT while choosing whom to pray
# to: the bones speak (a line of our own).
seed 3
game fossilfeud
wait 10
cheat match 0
wait 20
press A
wait 5
expect mp == 1
expect save_secret == 0
press LEFT
press RIGHT
press RIGHT
press LEFT
press LEFT
expect secret_t == 0
press LEFT
expect secret_t > 0
expect save_secret == 1
expect mp == 1
