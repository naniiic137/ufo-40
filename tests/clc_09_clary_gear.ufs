# CLARION CALL: Clary behind a door, and her gear. Here she uses the bar:
# a hit costs two points (4 half points), then a second of grace; the Tin
# Plate halves every hit. The Fan Shot adds two short shots; Ghost Lead
# shots fly through walls; Creeper Caps crawl on from where a shot hits;
# the Big Bang makes a tap a triple-damage shot that costs a coin (held
# fire stays plain and free); Feather Boots slow her fall while A is held
# (behind doors only); the Lucky Thimble does nothing at all. Outside, the
# Homing Charm calls the ship to her with a second jump in the air (and
# earns the gift goal); the Magnet pulls coins and notes in.
seed 1
game clarion
wait 10
cheat area 5 0
wait 2
cheat enter_room 10
wait 2
expect room == 10
expect sub_y == 144
# a hit, the grace, and the plate (she has a moment's grace coming in, too)
wait 40
cheat sub_ent 30 48 144
wait 3
expect hp == 12
expect sub_inv > 0
wait 10
expect hp == 12
cheat boss_down
cheat no_foes
cheat gear 15
wait 70
cheat sub_place 160 144
cheat sub_ent 30 168 144
wait 3
expect hp == 10
cheat no_foes
# toffee: five points back; a heart pin: a bigger bar
cheat give 18
expect hp == 16
cheat give 16
expect hpmax == 20
expect hp == 20
# the fan shot
cheat gear 6
cheat sub_place 100 144
cheat face 1
wait 20
press B 1
expect shotk0 == 1
expect shotk1 == 2
# the big bang: a tap costs a coin; held fire is plain
cheat gear 9
cheat coins 5
cheat clear_shots
wait 20
press B 1
expect shotk2 == 1
expect coins == 4
cheat clear_shots
wait 20
hold B 20
expect coins == 3
expect shotk0 >= 1
# ghost lead: through the wall (no coins, so taps are plain shots)
cheat coins 0
cheat clear_shots
cheat sub_place 280 144
cheat face 1
wait 20
press B 1
wait 12
expect shotk0 == 0
cheat gear 7
wait 20
press B 1
wait 12
expect shotk0 == 1
# creeper caps: a shot that hits a wall crawls on
cheat clear_shots
wait 30
cheat sub_place 280 144
cheat face 1
cheat give 8
wait 20
press B 1
wait 12
expect shotk3 == 0
# (ghost lead lets shots through, so take it off to see the caps)
cheat area 5 0
wait 2
cheat enter_room 10
wait 2
cheat gear 8
cheat sub_place 280 144
cheat face 1
wait 20
press B 1
wait 8
expect shotk3 == 1
# feather boots: a slow fall with A held
cheat sub_place 160 40
hold A 30
expect sub_vy > 1200
cheat gear 5
cheat sub_place 160 40
hold A 30
expect sub_vy < 430
# the lucky thimble: nothing changes
cheat gear 10
expect has10 == 1
# the homing charm, outside
cheat area 6 2
wait 2
cheat no_foes
expect goals == 0
cheat gear 11
expect goals == 1
cheat foot 120 248
wait 5
press A 6
press A 2
expect on_foot == 0
expect ship == 0
expect ship_x >= 116
expect ship_x <= 124
# the magnet: a plum coin pulled in from 30 px (here to Clary on her feet)
cheat area 6 2
wait 2
cheat no_foes
cheat foot 120 248
cheat ent 25 150 244
wait 40
expect coins == 0
cheat area 6 2
wait 2
cheat no_foes
cheat gear 12
cheat foot 120 248
cheat ent 25 150 244
wait 40
expect coins == 25
