# TIN TROOP: a stone dropped from the air falls at full speed and smashes
# down through any toy blocks below it, one after another; spikes under it
# are crushed, a flame under it goes out, a foe under it is flattened.
game tintroop
wait 5
cheat level 0
cheat no_foes
cheat freeze
wait 60
# a column of four blocks under a ledge of air
cheat put x 12 9
cheat put x 12 10
cheat put x 12 11
cheat put x 12 12
expect count_breakable == 7
cheat pos 118 71
wait 1
press DOWN+B
wait 40
expect count_breakable == 3
expect stone_y == 120
# spikes
cheat put ^ 6 12
cheat put ^ 7 12
cheat pos 62 91
wait 1
press DOWN+B
wait 20
expect tile_6_12 == 32
expect stone_y == 120
# a flame
cheat put f 16 12
cheat pos 158 91
wait 1
press DOWN+B
wait 20
expect tile_16_12 == 99
# a mouse
cheat foe mouse 180 130
cheat pos 178 91
wait 1
press DOWN+B
wait 20
expect kills == 1
