# UNDERDELVE: climbing a ladder to its top leaves Mo standing on the ledge,
# and he can walk off onto the plank beside it.
game underdelve
wait 10
press A
wait 5
cheat room 1 0 83 130
cheat clear_enemies
cheat no_gloom
wait 5
expect grounded == 1
hold UP 5
expect climbing == 1
hold UP 150
expect climbing == 0
expect grounded == 1
expect py == 34
hold RIGHT 20
expect py == 34
expect px > 95
