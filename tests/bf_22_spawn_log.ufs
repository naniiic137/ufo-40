# BANNERFALL: every campaign battle, ranked and survival spawn their whole
# pools for both armies and nothing else (the log behind the report on
# unit variety). Each battle is fast-forwarded with B for about 48 turns
# with banners that can't run out.
seed 40
game bannerfall
wait 5
# battle 1 Morning Muster: F vs F
cheat battle 1
cheat flags 99 99
hold B 4000
expect level == 1
expect spawn_mask_l & 2
expect spawn_mask_r & 2
expect spawn_mask_l !& 508
expect spawn_mask_r !& 508
# battle 2 Bows At Dawn: BF vs FF
cheat battle 2
cheat flags 99 99
hold B 4000
expect level == 2
expect spawn_mask_l & 2
expect spawn_mask_r & 2
expect spawn_mask_l & 4
expect spawn_mask_l !& 504
expect spawn_mask_r !& 508
