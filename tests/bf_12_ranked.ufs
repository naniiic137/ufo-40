# BANNERFALL ranked: three banners each, the host gets rank% more units, and
# the rank moves with the banner difference: +10/+4/+2, -1/-3/-5.
game bannerfall
wait 5
cheat rank 20
cheat ranked
expect flags_l == 3
expect flags_r == 3
expect handicap == 20
cheat clear
cheat flags 2 1
cheat unit 7 2 1 0
cheat endturn
wait 200
expect rank == 24
cheat ranked
cheat clear
cheat flags 1 3
cheat unit 0 2 1 1
cheat endturn
wait 200
expect rank == 19
expect best_rank == 24
