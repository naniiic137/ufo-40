# PETAL PARADE: the run ends as soon as 200 pups are saved (the Saucer);
# without 20,000 points there is no Alien.
game petalparade
wait 20
press A
cheat clear
cheat saved 198
cheat put pup 5 7
cheat put pup 5 6
cheat put pup 5 5
cheat put pad 5 7
cheat put pad 5 6
cheat put pad 5 5
wait 40
press B
expect saved == 201
expect state == 4
expect goals & 2
expect goals !& 4
expect goals !& 1
wait 320
press A
wait 3
expect state == 0
