# UNDERDELVE: the Deep Gate over the locked shaft stays shut without the
# brass key and opens for it; the gate hall above it has a ladder on up to
# the headframe walk. The Lantern Keeper sells lanterns for 100 ore.
game underdelve
wait 15
cheat no_gloom
cheat room 0 2 147 130
cheat clear_enemies
hold UP 240
expect room_y == 2
expect gate_open == 0
cheat give 16
hold UP 240
expect gate_open == 1
expect room_y == 1
expect room_x == 0
hold RIGHT 80
hold UP 240
expect room_y == 0
expect room_x == 0
cheat room 1 0 115 130
cheat lanterns 3
cheat money 250
wait 5
press UP
expect lanterns == 4
expect money == 150
press UP
expect lanterns == 5
expect money == 50
press UP
expect lanterns == 5
