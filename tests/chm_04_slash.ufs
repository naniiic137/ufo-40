# CHIME CIRCUIT: B slashes to the side the ship faces. It does no damage:
# it knocks the ship it reaches away (3.6 px a frame) and leaves it unable
# to steer for a moment (its thrust still works), so it may fly into a
# wall. A ship behind is safe. Slashing also slows the slasher's fall a
# little.
seed 1
game chime
wait 30
cheat race 1
cheat park_cpus
cheat go
cheat idle 1
cheat place 0 120 30
cheat place 1 134 30
cheat face 0 1
press B
expect knocks0 == 1
expect vx1 > 800
expect stun1 > 0
expect hp1 == 3
expect hp0 == 3
expect slash0 > 0
# the knocked ship flies off and keeps its hit points
wait 10
expect x1 > 150
# a ship behind isn't reached
wait 40
cheat place 0 120 30
cheat place 1 106 30
cheat vel 1 0 0
cheat face 0 1
press B
expect knocks0 == 1
expect vx1 == 0
# turn round (a tap left) and it is
wait 30
cheat place 0 120 30
cheat place 1 106 30
cheat vel 1 0 0
cheat hp 1 3
hold LEFT 1
expect face0 == -1
press B
expect knocks0 == 2
expect vx1 < -800
expect hp1 == 3
# a knocked ship can't steer, but it can still thrust
wait 30
cheat stun 0 16
cheat place 0 60 40
cheat vel 0 0 0
hold RIGHT+A 5
expect vx0 == 0
expect vy0 == -150
expect stun0 == 11
# a fall of three frames, plain and then with a slash: the slash slows it
cheat stun 0 0
cheat place 0 60 22
cheat vel 0 0 600
wait 3
expect vy0 == 660
cheat place 0 60 22
cheat vel 0 0 600
press B
expect vy0 < 480
expect vy0 > 400
