# CHIME CIRCUIT: B slashes to the side the ship faces. It does no damage:
# it knocks the ship it reaches away (3.6 px a frame) and leaves it unable
# to steer for a moment, so it may fly into a wall. A ship behind is safe.
seed 1
game chime
wait 30
cheat race 1
cheat park_cpus
cheat go
cheat idle 1
cheat place 0 120 30
cheat place 1 134 30
cheat face 0 1
press B
expect knocks0 == 1
expect vx1 > 800
expect stun1 > 0
expect hp1 == 3
expect hp0 == 3
expect slash0 > 0
# the knocked ship flies off and keeps its hit points
wait 10
expect x1 > 150
# a ship behind isn't reached
wait 40
cheat place 0 120 30
cheat place 1 106 30
cheat vel 1 0 0
cheat face 0 1
press B
expect knocks0 == 1
expect vx1 == 0
# turn round (a tap left) and it is
wait 30
cheat place 0 120 30
cheat place 1 106 30
cheat vel 1 0 0
cheat hp 1 3
hold LEFT 1
expect face0 == -1
press B
expect knocks0 == 2
expect vx1 < -800
expect hp1 == 3
