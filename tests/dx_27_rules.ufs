# DUNE EXPRESS, more of Rail Heist's rules with the buttons: a thrown anvil
# kills without a sound (nobody turns alert, no turns start); an unarmed
# guard walked into takes the auto punch; the horseshoe takes one bullet,
# not two; spring boots jump again in the air, higher; at zero the train
# reaches town; a lawman won't use a ladder with a box on it; a gun left
# drawn fires by itself at a lawman in its sight on the lawmen's turn.
game dune
wait 5
# the anvil, thrown into a guard's back
cheat mission 3
cheat law 0 11 6 1 0
cheat face 0
hold DOWN
press B
release DOWN
wait 2
expect carry == 3
hold RIGHT 1
press B
wait 40
expect kills == 1
expect law0_alive == 0
expect law1_state == 0
expect phase == 0
# the auto punch: the crate guard has no gun
cheat mission 19
cheat pos 22 6
cheat face 1
expect law2_armed == 0
hold RIGHT 20
expect law2_stun > 170
expect alive == 1
# the horseshoe
cheat mission 1
cheat power 4
cheat pos 6 6
cheat law 0 9 6 0 0
wait 3
expect alive == 1
expect charm == 0
expect law0_armed == 0
cheat law 0 30 6 1 0
cheat law 1 9 6 0 0
wait 3
expect alive == 0
expect why == 1
# one jump without the boots, two with them
cheat mission 1
cheat clear_law
cheat pos 4 6
wait 2
hold A 18
press A
hold A 12
expect y > 60
cheat mission 1
cheat clear_law
cheat power 3
cheat pos 4 6
wait 2
hold A 18
press A
hold A 12
expect y < 0
# the master timer
cheat mission 1
cheat master 1
wait 70
expect result == 2
expect why == 6
# a gunshot on the roof: the guard below climbs the ladder to it...
cheat mission 1
cheat law 0 6 6 0 0
cheat pos 14 2
cheat face 1
hold UP 135
press B
expect law0_state == 2
wait 600
wait 150
expect law0_y < 70
# ...but not with a box put down at its foot
cheat mission 1
cheat pos 4 6
cheat face 1
hold DOWN
press B
release DOWN
wait 2
hold RIGHT 64
hold DOWN
press B
release DOWN
wait 2
expect carry == 0
cheat law 0 6 6 0 0
cheat pos 14 2
cheat face 1
hold UP 135
press B
expect law0_state == 2
wait 600
wait 210
expect law0_y == 82
# the drawn gun on the lawmen's turn
cheat mission 1
cheat face 1
cheat law 0 8 6 1 1
hold UP 132
expect gun == -1
expect phase == 1
expect law0_alive == 1
wait 460
expect phase == 1
expect law0_alive == 1
wait 20
expect law0_alive == 0
expect kills == 1
expect ammo == 0
