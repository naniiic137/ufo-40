# PETAL PARADE: pups Posy walks over follow her in a line; running into
# the line ends the run.
game petalparade
wait 20
press A
cheat clear
cheat put pup 5 7
cheat put pup 5 6
cheat put pup 5 5
cheat put pup 5 4
wait 20
expect line == 1
wait 24
expect line == 4
expect pups == 0
press RIGHT
expect hx == 6
expect hy == 4
press DOWN
wait 5
expect hy == 5
press LEFT
wait 8
expect state == 1
wait 1
expect state == 2
