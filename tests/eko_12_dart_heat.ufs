# DART: tapping A fires at once and fast tapping is the fastest fire; the
# gun never heats. Holding A fires slower, and after a moment the barrel
# heats; let it boil over and the bike blows up: a whole life gone.
seed 1
game echounit
wait 5
cheat mission 2
cheat knospawn
cheat kclear
wait 10
expect k_heat == 0
press A 1
wait 2
press A 1
wait 2
press A 1
wait 2
press A 1
wait 2
press A 1
wait 2
press A 1
wait 2
press A 1
wait 2
press A 1
wait 2
expect k_shots == 8
expect k_heat == 0
# holding: slower, and it heats
hold A 40
expect k_shots <= 13
expect k_heat > 0
wait 120
expect k_heat == 0
expect lives == 2
hold A 130
waituntil k_overheat == 1 30
expect lives_lost == 1
waituntil lives == 1 200
expect k_heat == 0
