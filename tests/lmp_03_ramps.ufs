# LIMPET: ramps carry the tank round corners: into a corner and up the wall,
# over the top of a block and down again, on with the same button held.
# On a wall UP and DOWN roll it; a sheer wall stops it.
game limpet
wait 5
cheat level 1
cheat nofoes
cheat pos 8 15 0
wait 2
hold RIGHT 30
wait 10
expect tx == 10
expect tn == 6
expect ty < 15
cheat pos 10 12 6
wait 2
press UP 1
wait 8
expect ty == 11
press DOWN 1
wait 8
expect ty == 12
# up the face, round the top corner and onto the block's top
hold UP 50
wait 10
expect tn == 0
expect ty == 5
# a sheer wall: the deck's left wall
cheat pos 4 15 0
wait 2
hold LEFT 40
wait 8
expect tx == 1
expect tn == 0
