# ROOFCAT: every third defeated foe drops catnip, while she holds fewer than
# two. Losing a life loses them.
game roofcat
wait 5
cheat area 0 1
cheat cam 0
cheat clear_foes
cheat put 40 115
wait 20
cheat foe snail 90 112
press B
wait 30
cheat foe snail 90 112
press B
wait 30
expect count_catnip == 0
cheat foe snail 90 112
press B
wait 12
expect count_catnip == 1
hold RIGHT 40
expect power == 1
cheat kill
expect power == 0
