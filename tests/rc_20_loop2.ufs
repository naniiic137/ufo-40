# ROOFCAT: the second loop swaps in tougher foes: snails take two stars and
# drop 200, and laundry sheets and dust moths only come out after dark.
game roofcat
wait 5
cheat area 1 1
cheat clear_foes
wait 2
expect count_sheet == 0
cheat foe snail 200 80
expect hp_snail == 1
cheat area 1 2
wait 2
expect count_sheet == 1
cheat foe snail 200 80
expect hp_snail == 2
