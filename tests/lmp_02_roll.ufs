# LIMPET: the tank rolls one tile at a time along the surface it clings to
# (seven frames a tile), the pad's other two ways do nothing, and it can
# neither drive off a ledge nor climb a sheer wall.
game limpet
wait 5
cheat level 0
wait 2
expect tx == 2
expect ty == 15
expect tn == 0
press RIGHT 1
expect moving == 1
wait 8
expect moving == 0
expect tx == 3
hold RIGHT 28
wait 8
expect tx >= 6
cheat pos 7 15 0
wait 2
hold UP 20
hold DOWN 20
expect tx == 7
expect ty == 15
expect tn == 0
# a sheer wall: the low wall at x 11
hold RIGHT 60
wait 8
expect tx == 10
expect tn == 0
# a ledge: the top of the low wall ends at x 12
cheat pos 11 10 0
wait 2
hold RIGHT 40
wait 8
expect tx == 12
expect ty == 10
# on the ceiling, left and right still roll
cheat pos 5 1 4
wait 2
hold RIGHT 15
wait 8
expect tx >= 6
expect ty == 1
expect tn == 4
