# LANDFALL: the big shell (the snail) stands in the mouth of a way into a
# side room. It can't be hurt and costs 3 to touch, so she can push past
# it only by taking the hit (or in a moment of safety). A chop draws it
# (each chop from the chop press burns a resource rolled per planet:
# beads here); once it has left the way it never goes back. The thumper
# leaves an empty shell, and that one is a wall: only a small Wick slips
# past, and only when the shell faces away from where she is going. Once
# she leaves its room the big shell is back on its spot.
game landfall
wait 5
cheat nomobs
cheat planet 15
cheat room 39 40 100
expect gate0_kind == 6
expect gate0_snail == 0
expect gate0_open == 0
expect mobs == 1
expect mob0_hp == 99
# rivets only clink
cheat hold 1 5
cheat face 1
cheat pos 90 104
press A
wait 20
expect mob0_hp == 99
expect mob0_alive == 1
# pushing past it: one hit of 3, and through into the side room
cheat hp 7 7
cheat pos 138 70
hold DOWN 60
wait 45
expect room == 48
expect hp == 4
expect hits == 1
expect last_hurt == 4
# a fresh planet: a chop to the left draws it off the way, for good
cheat planet 15
cheat room 39 40 100
cheat hold 6 5
cheat face 2
press A
expect flash0 > 0
expect chops == 0
cheat res 0 2
press A
expect chops == 1
expect res0 == 1
hold UP 20
waituntil gate0_snail == 1 300
expect gate0_open == 1
waituntil chops == 0 400
# down the way unhurt: two beads (the rare one here) lie in the side room
cheat pos 138 80
hold DOWN 60
wait 45
expect room == 48
expect hits == 0
expect res0 == 1
hold DOWN 80
expect res0 == 3
# another fresh planet: thumped from the side, the shell faces her (west)
cheat planet 15
cheat room 39 100 104
cheat hold 4 2
cheat res 1 3
wait 2
press A
expect shells == 1
expect gate0_snail == 2
expect mob0_face == 3
# small (a ricochet off the top wall), she still can't get by going south
press B 3
cheat face 0
press A
waituntil small == 1 120
cheat pos 140 84
hold DOWN 60
expect room == 39
expect py < 95
# out of the room and back: a live big shell on its spot again
hold UP 20
waituntil small == 0 400
cheat room 12 140 100
cheat room 39 40 100
expect gate0_snail == 0
expect shells == 0
expect mobs == 1
# thumped from above, it faces north, away from the side room: a small
# Wick slips through it going south
cheat room 39 136 82
cheat hold 4 5
wait 2
press A
expect shells == 1
expect gate0_snail == 2
expect gate0_open == 0
# full size, the shell is a wall
hold DOWN 40
expect room == 39
expect py < 90
expect hits == 0
# a ricochet off the top edge: small, and through
cheat pos 136 82
cheat hold 2 5
cheat face 0
press A
waituntil small == 1 120
hold DOWN 80
wait 45
expect room == 48
expect hits == 0
# she has left its room: the big shell is back in the way
expect gate0_snail == 0
waituntil small == 0 400
hold UP 30
wait 45
expect room == 39
expect mobs == 1
expect shells == 0
