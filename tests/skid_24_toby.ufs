# SKID KIDS: TOBY (Marc's kit). He picks things up in half the time; his
# special throw is the COMET; his move is the SPLASH.
game skidkids
wait 5
cheat match 8 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 100 100
cheat loose 104 100
press B
wait 6
expect held0 == 1
# the comet
cheat clearbags
cheat kid 2 230 108
cheat stars 0 2
cheat give 0 1
hold B 70
wait 2
expect bagkind0 == 1
waituntil score0 == 1 60
# the splash
waituntil kst2 == 0 100
cheat clearbags
cheat kid 0 100 60
cheat kid 2 190 60
cheat stars 0 2
press A
wait 5
press A
waituntil puddles == 1 60
expect kst2 == 5
