# DUSKLING: any touch of a deadly foe, thorns or a fall ends the duskling,
# but lives never run out: it comes back where it came into the room, and
# the room starts over.
game duskling
wait 5
cheat room 2
cheat pos 500 141
wait 1
expect alive == 1
waituntil alive == 0 200
expect deaths == 1
waituntil alive == 1 60
expect room == 2
expect px == 11
expect py == 141
expect count_prickle == 1
# thorns
cheat room 4
cheat pos 620 141
hold A 30
expect alive == 0
expect deaths == 2
wait 40
expect px == 11
# a pit
cheat room 2
cheat pos 265 101
hold A 60
expect alive == 0
expect deaths == 3
wait 40
# again and again: there is no game over
cheat pos 620 141
hold A
waituntil alive == 0 200
release
wait 40
cheat room 4
cheat pos 620 141
hold A 30
wait 40
expect deaths == 5
expect alive == 1
expect state == 2
