# PETAL PARADE: walking into the hedge ends the run; there are no lives.
# The score goes on the board of five.
game petalparade
wait 20
press A
cheat clear
cheat score 150
wait 72
expect hy == 0
expect state == 1
wait 8
expect state == 2
expect hi0 == 150
expect new_rank == 0
wait 95
expect state == 3
press A
wait 70
press A
wait 3
expect state == 0
