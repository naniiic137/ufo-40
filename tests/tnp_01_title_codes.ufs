# the practice drive: no clock, no harm, no events, no end
press UP
press A
wait 5
expect state == 4
expect practice == 1
expect event == 0
expect time_f == 0
wait 120
expect time_f == 0
expect state == 4
# straight into the canal: back at a drop zone, unhurt
cheat pos 400 894
cheat ang 90
cheat vel 0 2
wait 120
expect falls == 1
expect hearts == 3
expect state == 4
cheat delivered 6
cheat clockout
wait 30
expect state == 4
# nothing saved, no goal
expect save_starts == 0
expect goals == 0
