# ROOFCAT: the screen scrolls on its own and carries Harissa along;
# running right gains ground, holding left gives ground back.
game roofcat
wait 5
press A
wait 100
expect state == 2
expect chunk_errors == 0
expect screen_x == 48
wait 60
expect cam >= 29
expect screen_x == 48
hold RIGHT 20
expect screen_x == 74
hold LEFT 20
expect screen_x == 48
