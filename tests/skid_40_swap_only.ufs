# SKID KIDS: the SWAP-ONLY code (switch on its own button): B only swaps
# kids, and never passes; pick up, throw and pass move to A: A picks up, a
# tap of A with a bag passes it (you keep the kid you drive), holding A
# winds up (a short hold tosses, B calls it off), and with empty hands A
# jumps.
seed 22
game skidkids
wait 5
cheat code SWAPONLY
cheat match 0 1 3 11 0
expect swap_only == 1
cheat coach 0
cheat clearbags
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 60 100
cheat kid 1 60 150
cheat loose 64 100
press A
expect kst0 == 1
wait 16
expect held0 == 1
expect kz0 == 0
# B only swaps: the bag stays where it is
press B
expect ctrl0 == 1
expect n_swap == 1
expect n_pass == 0
expect held0 == 1
press B
expect ctrl0 == 0
expect n_pass == 0
expect held0 == 1
# a tap of A passes it across, and you keep your kid
press A
expect n_pass == 1
expect ctrl0 == 0
expect n_swap == 2
waituntil held1 == 1 40
expect held0 == 0
# on the kid with the bag, A held winds up; B calls it off
press B
expect ctrl0 == 1
hold A
wait 20
expect kst1 == 2
press B
expect kst1 == 0
expect n_cancel == 1
expect ctrl0 == 1
release A
wait 5
# a short hold of A tosses it
hold A 12
wait 2
expect n_toss == 1
expect held1 == 0
wait 30
# A with empty hands and nothing near jumps
cheat clearbags
press A
expect kz1 > 0
