# the shellcrab
cheat clear
cheat foe 10 120 139
wait 2
hold DOWN A 2
release
wait 10
expect foe0_alive == 1
expect foe0_state == 2
expect foe0_harmless == 1
wait 240
expect foe0_state == 1
# the weeper, eye shut then open
cheat clear
cheat pos 100 144
cheat foe 12 140 127
cheat foet 0 0
wait 1
press A
wait 10
expect foe0_hp == 20
cheat foet 0 95
wait 1
press A
wait 10
expect foe0_hp == 12
# the shieldling, shield up toward him
cheat clear
cheat foe 16 140 137
cheat foet 0 0
wait 1
hold DOWN A 2
release
wait 10
expect foe0_alive == 1
cheat foet 0 125
wait 1
hold DOWN A 2
release
wait 10
expect foe0_alive == 0
# the hive
cheat clear
cheat foe 4 200 70
wait 120
expect foes_5 >= 1
