expect foe0_kind == 15
expect foe0_hp == 42
expect hp_of_15 == 42
cheat clear
cheat foe 16 260 60
expect foe0_kind == 16
expect foe0_hp == 1
expect hp_of_16 == 1
cheat clear
cheat foe 17 260 60
expect foe0_kind == 17
expect foe0_hp == 80
expect hp_of_17 == 80
cheat clear
cheat foe 18 260 60
expect foe0_kind == 18
expect foe0_hp == 5
expect hp_of_18 == 5
