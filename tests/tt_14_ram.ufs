# TIN TROOP: a tin ram charges a soldier who steps onto its level. Its
# brass brow turns a lance aimed at its face, but from behind it goes down;
# jumped over, it charges on into the wall and stands dazed.
game tintroop
wait 5
cheat level 0
cheat no_foes
wait 60
# a lance into its face: the soldier falls, the ram stands
cheat freeze
cheat pos 60 121
cheat foe ram 150 130 -1
wait 10
hold RIGHT 2
press B
wait 30
expect count_foes == 1
expect count_corpse == 1
expect kills == 0
# from behind it goes down
cheat no_foes
cheat foe ram 150 130 1
cheat pos 60 121
wait 10
hold RIGHT 2
press B
wait 30
expect count_foes == 0
expect kills == 1
# on its level it charges; jump it, and it runs into the wall behind
cheat freeze
cheat foe ram 150 130 -1
cheat pos 40 121
wait 30
expect foe0_x < 145
hold A 30
wait 40
expect foe0_x < 40
cheat pos 90 121
wait 5
hold LEFT 2
press B
wait 20
expect count_foes == 0
expect kills == 2
