# FENNEC FOUNTAIN: a block pushes another only if its number is equal or
# higher, and chains push along.
game fennec
wait 5
cheat setroom #########/#K.32...#/#########
cheat moves RR
expect tile41 == 13
expect tile51 == 12
expect px == 3
cheat setroom #########/#K.23...#/#########
cheat moves RR
expect px == 2
expect tile31 == 12
expect tile41 == 13
cheat setroom #########/#K.22...#/#########
cheat moves RR
expect tile41 == 12
expect tile51 == 12
# the fennec pushes any sandstone itself
cheat setroom #########/#K.4....#/#########
cheat moves RR
expect tile41 == 14
