press DOWN
press DOWN
press DOWN
press DOWN
press A
expect codes == 1
press B
wait 5
expect state == 0
# the title now has a fourth line
press DOWN
expect sel == 3
press A
wait 5
expect state == 4
expect mode == 2
expect vs_target == 10
expect p0_x < 160
expect p1_x > 160
expect foes == 0
expect counts == 20
# into the left goal: a point for the right
cheat pos 0 160 160
cheat pos 1 220 160
cheat ball 40 150 -4 0
waituntil vs_score1 == 1 60
expect vs_score0 == 0
wait 110
expect ball_x == 160
expect sub == 1
# a slide into the kid with the ball knocks it loose
cheat pos 1 200 160
cheat carry 1
cheat pos 0 170 160
wait 2
hold RIGHT 2
press B 1
wait 10
expect carrier == -1
expect ball_last == 0
# into the right goal, and the tenth: the end
cheat vsscore 9 3
cheat pos 0 160 160
cheat pos 1 160 160
cheat ball 280 150 4 0
waituntil vs_score0 == 10 60
waituntil state == 8 200
wait 420
expect state == 0
# with a code on: no saving, no goals
expect save_runs == 0
press DOWN
press A
wait 10
press A
wait 50
press A
wait 5
expect state == 4
cheat win
expect goals.hattrick == 0
expect save_runs == 0
