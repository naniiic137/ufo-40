# WET PAINT: park in the bottom-right corner of course 1 while the foes take
# the floor to 80% pink, and the results screen has a message for you.
game wetpaint
wait 5
cheat course 1
cheat go
cheat nogarages
cheat car 25 12 0
wait 5
expect stopped == 1
cheat fill 2 150
wait 2
expect secret == 0
cheat fill 2 160
wait 2
expect secret == 1
cheat time 1
wait 2
expect res_secret == 1
expect res_pass == 0
# anywhere else, nothing
cheat course 1
cheat go
cheat nogarages
cheat car 0 0 3
cheat fill 2 190
wait 2
expect secret == 0
