# DUKES UP: A picks up whatever you stand on (the same button as a punch).
# Food heals (apple a fifth, sandwich a third, drumstick half, roast chicken
# all of it), or is cash if you're already at full health ($2, $4, $6, $10).
# Coins are $1, a five $5, a gold ring $10. Carried things: A uses them
# (swing, shoot, saw or throw), B throws them; a bin is too heavy to run
# with, and a plank or chainsaw is dropped when you break into a run.
# Bending down to pick anything up leaves you open for a moment.
game dukesup
wait 5
cheat pick 1 0
cheat run 1
cheat arena
cheat freeze
cheat pos 1 100 140
cheat hp 1 50
cheat item apple 100 140
wait 2
press A 1
wait 12
expect p1_hp == 70
cheat item sandwich 100 140
wait 2
press A 1
wait 12
expect p1_hp == 100
cheat hp 1 10
cheat item drumstick 100 140
wait 2
press A 1
# bending down for it leaves you open a moment
expect p1_state == 1
wait 12
expect p1_state == 0
expect p1_hp == 60
cheat item roast_chicken 100 140
wait 2
press A 1
wait 12
expect p1_hp == 100
expect cash == 0
# at full health it's cash
cheat item apple 100 140
wait 2
press A 1
wait 12
expect cash == 2
cheat item sandwich 100 140
wait 2
press A 1
wait 12
expect cash == 6
cheat item drumstick 100 140
wait 2
press A 1
wait 12
expect cash == 12
cheat item roast_chicken 100 140
wait 2
press A 1
wait 12
expect cash == 22
cheat item coins 100 140
wait 2
press A 1
wait 12
cheat item a_five 100 140
wait 2
press A 1
wait 12
cheat item gold_ring 100 140
wait 2
press A 1
wait 12
expect cash == 38
expect items == 0
# a plank: picked up, ready after a moment, swung (POWER + 4) with a knock-down
cheat face 1 1
cheat item plank 100 140
cheat spawn shambler 126 140
cheat foehp 2 50
wait 2
press A 1
expect p1_carry == 8
wait 2
press A 1
wait 20
expect foe2_hp == 50
wait 10
press A 1
wait 30
expect foe2_hp == 44
expect foe2_state == 4
# B throws it
wait 30
cheat foepos 2 160 140
wait 2
press B 1
expect p1_carry == 0
wait 20
expect foe2_hp == 38
# a plank is dropped when you break into a run
cheat arena
cheat item plank 100 140
wait 2
press A 1
expect p1_carry == 8
wait 20
press RIGHT 1
hold RIGHT
wait 4
release
expect p1_carry == 0
expect items_8 == 1
# a bin is too heavy to run with
cheat arena
cheat pos 1 100 140
cheat item bin 100 140
wait 2
press A 1
expect p1_carry == 14
wait 20
press RIGHT 1
hold RIGHT
wait 4
expect p1_running == 0
release
# the scattergun: six shots, then it's spent
cheat arena
cheat pos 1 100 140
cheat face 1 1
cheat item scattergun 100 140
wait 2
press A 1
expect p1_carry == 12
expect p1_ammo == 6
wait 20
press A 1
wait 25
press A 1
wait 25
press A 1
wait 25
press A 1
wait 25
press A 1
wait 25
expect p1_ammo == 1
press A 1
wait 25
expect p1_carry == 0
# the chainsaw fells a shambler outright
cheat arena
cheat pos 1 100 140
cheat face 1 1
cheat item chainsaw 100 140
cheat spawn shambler 124 140
cheat foehp 2 500
wait 2
press A 1
expect p1_carry == 13
wait 20
press A 1
wait 30
expect foe2_alive == 0
