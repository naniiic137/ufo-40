# LOST LINKS: the Beacon is finding the Hammerhead (Golfaria's gift: the
# Block Buster). Everything found is saved at once; CONTINUE wakes Dimple
# at the last pin touched. NEW GAME over a save asks first (NO is the
# default) and then starts clean.
game lostlinks
wait 5
cheat newgame
cheat no_slicers
expect goals !& 1
cheat ball 1 34 18
cheat aim 0
hold A 10
wait 1
waituntil abilities == 1 300
expect goals & 1
expect goals !& 2
expect state == 3
wait 15
press A
cheat checkpoint 3
cheat irons 7
cheat save
reload
game lostlinks
wait 5
expect state == 0
expect has_save == 1
expect goals.lostlinks == 1
# CONTINUE: from the Rootcrawl pin, with the Hammerhead and three irons
press A
wait 2
expect state == 2
expect abilities == 1
expect irons == 3
expect strokes == 29
expect checkpoint == 3
expect layer == 1
expect btx == 32
expect bty == 27
# NEW GAME asks; NO keeps the save
reload
game lostlinks
wait 5
press DOWN
press A
press A
expect state == 0
expect abilities == 1
# YES starts again from nothing (the cursor is still on NEW GAME)
press A
press RIGHT
press A
expect state == 1
expect abilities == 0
expect irons == 0
expect checkpoint == 255
expect goals.lostlinks == 1
