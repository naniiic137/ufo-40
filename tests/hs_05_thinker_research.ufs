# HOMESPUN: the Thinker is broken until a gear comes home from the Wilds;
# then each hand there makes 1 data a minute (six hands at most). Dr.
# Orrery researches for bars, data and thread, and trades 100 bars for 20
# data.
seed 44
game homespun
wait 5
cheat newgame 105
wait 5
cheat huts 3 3
cheat at 296 97
cheat face 0 1
press A
expect menu == 1
expect menu_n == 1
press A
expect lab_hands == 0
cheat lab 1 0
press A
press A
expect lab_hands == 1
press A
press A
expect lab_hands == 3
press B
cheat res data 0
idle 2
expect data == 6
# Dr. Orrery
cheat at 272 105
cheat face 0 1
cheat res bars 250
cheat res data 100
press A
expect menu == 1
# the Star yo-yo and Starfuel are not offered yet
expect menu_n == 5
press A
expect research == 1
expect bars == 100
# the Star yo-yo is offered now; Fertilizer is under the cursor
expect menu_n == 5
press A
expect research == 3
expect data == 0
# the trade: 100 bars for 20 data
press UP
press A
expect bars == 0
expect data == 20
# Big Bins, then Starfuel appears
cheat res bars 200
cheat res thread 150
press B
press A
press A
expect research == 7
expect bars == 0
expect thread == 0
press B
cheat res bars 1000
cheat res data 1000
cheat bins 2 2
press A
press DOWN
press DOWN
press A
expect research == 39
press B
