# SKID KIDS: codes, spelt out on the title's CODES screen. ALLS-TARS puts
# the kangaroo and the robot in HAND-PICK. While any code is on nothing is
# saved and no goal is earned, until the cartridge is left.
seed 20
game skidkids
wait 20
press DOWN
press DOWN
press DOWN
press DOWN
press A
wait 10
expect state == 13
press A
expect codes == 0
press RIGHT
hold UP 70
press RIGHT
hold UP 70
press RIGHT
hold UP 105
press RIGHT
hold UP 110
press RIGHT
press RIGHT
hold UP 100
press RIGHT
hold UP 105
press A
expect codes == 1
press B
wait 10
expect state == 0
press UP
press UP
press UP
press UP
press A
wait 10
press DOWN
press A
wait 12
expect build_slots == 14
# pick the kangaroo (second row, sixth) and the robot beside it
press DOWN
press RIGHT
press RIGHT
press RIGHT
press RIGHT
press RIGHT
press A
press RIGHT
press A
wait 5
expect teama0 == 12
expect teama1 == 13
expect bracket_ok == 1
# a won tournament earns no goal and saves nothing
botuntil state == 7 800
cheat win 0
wait 160
botuntil state == 7 800
cheat win 0
wait 160
botuntil state == 7 800
cheat win 0
wait 160
expect wins == 3
expect goals == 0
expect used == 0
reload
game skidkids
wait 5
expect codes == 0
expect best == 0
expect save.skidkids == 0
