# SKID KIDS: SPARKY (Rizzik's kit). His wind-up is full in half the time;
# his special throw is the POPPER; his move is the SPLASH (a water balloon
# that bursts into a puddle: whoever it lands on falls, and whoever runs
# through the puddle slips).
game skidkids
wait 5
cheat match 4 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 100 100
cheat kid 2 200 100
cheat give 0 1
hold B 32
waituntil score0 == 1 60
expect kst2 == 5
# the popper
waituntil kst2 == 0 100
cheat clearbags
cheat kid 3 205 116
cheat stars 0 2
cheat give 0 1
hold B 32
waituntil n_boom == 1 90
expect score0 >= 3
# the splash lands ninety pixels ahead
waituntil kst2 == 0 100
cheat clearbags
cheat kid 0 100 60
cheat kid 2 190 60
cheat stars 0 2
press A
wait 5
press A
expect balloons == 1
waituntil puddles == 1 60
expect kst2 == 5
expect score0 == 3
# and a puddle trips whoever runs through it
cheat puddle 60 140
cheat kid 0 30 140
hold RIGHT 30
expect n_slip == 1
expect kst0 == 5
