# DUSKLING: not every creature is deadly in the same way. Thistledown
# drifts just over a standing duskling's head (a jump into it is the end);
# the crow is only a landmark; a frog is a spring; a gulper is a ledge
# while its mouth is shut and bites when it opens; a pebble beetle carries
# you, and a slam knocks it flying the way the side held points, where it
# curls up as a block.
game duskling
wait 5
cheat room 4
wait 2
cheat above_foe puff -20
wait 2
expect py == 141
wait 120
expect alive == 1
cheat room 4
wait 2
cheat above_foe puff -20
wait 2
hold A 4
hold A+UP 6
waituntil alive == 0 30
cheat room 4
wait 2
cheat above_foe crow -2
wait 30
expect alive == 1
# the frog
cheat room 3
wait 2
cheat above_foe frog 16
waituntil vy10 <= -50 20
expect alive == 1
# the gulper: a ledge, until it opens
cheat room 6
wait 2
cheat above_foe gulper 2
wait 6
expect ground == 1
expect alive == 1
waituntil alive == 0 160
# the beetle carries you along
cheat room 6
wait 2
cheat above_foe beetle 2
wait 4
expect ground == 1
expect foe_beetle_state == 0
wait 60
expect ground == 1
expect alive == 1
# a slam knocks it flying; it lands curled up, a block to stand on
cheat room 6
wait 2
cheat above_foe beetle 20
hold UP 1
hold UP+A 1
hold UP 12
expect foe_beetle_state == 1
waituntil foe_beetle_state == 2 90
expect alive == 1
