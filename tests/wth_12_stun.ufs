# WITHERLEA: the knife or the bar used on him knocks him down; leave the
# room while he's down and he loses you. Each weapon works once: strike him
# again with the same one and he blocks it and catches you.
game witherlea
wait 5
cheat new
cheat spawn 99999
cheat room hall
cheat keeper
wait 2
expect visible == 1
cheat hold knife
cheat cursor 160 108
press A
expect enc == 4
expect stuns == 1
expect flag_F_STUN_KNIFE == 1
expect visible == 1
cheat hush
# still down after a moment; out through the door
cheat aim S_HALL_PARLOUR
press A
wait 24
expect room == 4
expect enc == 0
expect escapes == 1
expect goals & 1
cheat hush
# left there, he gets up after 4 s and comes on
cheat hold none
cheat keeper
wait 2
cheat hold bar
cheat cursor 160 108
press A
expect enc == 4
expect stuns == 2
wait 241
expect enc == 2
cheat hush
# the knife a second time: blocked, caught
cheat hold knife
cheat cursor 160 108
press A
expect enc == 6
expect caught == 1
waituntil scene == 6 200
wait 61
press A
expect scene == 3
expect room == 0
# and the bar a second time too
cheat hold none
cheat keeper
wait 2
cheat hold bar
cheat cursor 160 108
press A
expect enc == 6
expect caught == 2
expect stuns == 2
