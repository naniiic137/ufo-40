# DUSKLING: pink ledges let you jump up through them and stand on top; a
# slam drops straight through them.
game duskling
wait 5
cheat room 1
cheat pos 876 141
wait 10
hold A 4
hold A+LEFT 16
hold A 8
wait 40
expect py == 111
expect ground == 1
hold A 4
hold A+UP 2
hold A 2
hold A+UP 1
wait 60
expect py == 141
