# LIMPET: moving platforms carry a tank clinging to them; crushers kill
# whatever they come down on, and clinging to one is as bad as spikes.
game limpet
wait 5
cheat level 18
cheat nofoes
cheat pos 11 11 0
wait 2
expect mover0_x == 10
wait 40
expect mover0_x > 10
expect tx > 11
expect ty == 11
expect state == 2
cheat level 10
cheat pos 20 15 0
wait 2
waituntil state == 3 200
expect last_hurt == 101
