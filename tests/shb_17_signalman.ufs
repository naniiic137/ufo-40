# SHUTTERBUG: the Signalman is a ghost: shots pass through him until a
# photo makes him solid. His green sparks set pink sparks crawling along
# his three tracks.
game shutterbug
cheat run 1
cheat stage 3
cheat lives 5
cheat goto 4560
cheat god
waituntil fstate_32 == 1 400
# shots pass through him (no photo taken)
cheat pos 60 84
hold B 400
expect photos == 0
expect foes_32 == 1
expect hp_32 == 150
expect eshots_4 > 0
botuntil stun_32 > 0 1200
botuntil hp_32 < 150 300
botuntil state == 6 6000
expect stage == 3
