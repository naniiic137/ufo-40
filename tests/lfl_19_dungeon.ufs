# LANDFALL: the dungeon. Its stairs lie in a gated side room; down them
# Wick stands on the stairs up in the first of six dense rooms in a line,
# each joined only to the one before and after, full of foes, with the
# third chart piece at the end of the line. Stairs she arrives on take her
# nowhere until she steps off them and back on. Going down or up brings
# every room back.
game landfall
wait 5
cheat nomobs
cheat planet 2
expect dun_entry == 4
cheat room 4 160 35
expect area == 0
expect tile_8_2 == 16
hold LEFT
waituntil area == 1 60
release LEFT
expect area == 1
expect room == 94
expect dun_step == 0
expect tile_8_4 == 17
expect neighbors == 1
# standing on the stairs up: nothing, until she steps off and on
wait 30
expect area == 1
hold RIGHT 14
expect area == 1
hold LEFT 14
expect area == 0
expect room == 4
# back down, and along the line: one way on from each room
hold RIGHT 14
hold LEFT
waituntil area == 1 60
release LEFT
expect room == 94
cheat room 93 140 70
expect dun_step == 1
expect neighbors == 2
cheat room 87 140 70
expect dun_step == 2
cheat room 81 140 70
expect dun_step == 3
cheat room 82 140 70
expect dun_step == 4
cheat room 76 100 66
expect dun_step == 5
expect neighbors == 1
# the chart piece at the end
expect maps == 0
hold RIGHT 20
expect maps == 1
expect map_from == 4
expect goals & 1
# foes in every room of the line
cheat mobs
cheat room 93 140 70
expect hostiles >= 1
