# GRUB SHIFT: ROLL moves Tilly and collects the fizz pods she rolls over;
# a used tool stays spent for the rest of the shift.
game grubshift
wait 5
cheat contract 1 7
cheat clear
cheat pods 3 2 1
cheat pods 4 2 2
cheat use 0 4 2
expect px == 4
expect energy == 3
expect spent == 1
cheat use 0 2 2
expect px == 4
expect spent == 1
