# ANTIPODE: one walking pace (1.5 px a frame), steering in the air too. B
# jumps: a tap is a hop, held it goes much higher (about 58 px). DOWN
# crouches and stops the walk.
seed 1
game antipode
wait 5
cheat newgame
cheat nofoes
cheat room 2 v
cheat pos 60 134
wait 5
expect ground == 1
expect py == 134
expect grav == 1
hold RIGHT 40
expect px == 120
expect face == 1
hold LEFT 20
expect px == 90
expect face == -1
# a tap: a hop
press B
waituntil vy >= 0 30
expect py >= 114
expect py <= 128
waituntil ground == 1 60
# held: much higher
wait 10
hold B 22
expect py <= 84
waituntil ground == 1 60
# steering in the air
cheat pos 90 134
wait 2
hold B RIGHT 30
expect px >= 130
waituntil ground == 1 60
# crouch: DOWN on the ground, no walking
hold DOWN RIGHT 20
expect crouch == 1
expect px <= 136
release ALL
wait 2
expect crouch == 0
