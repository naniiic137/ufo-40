# CHIME CIRCUIT: the five pickups. BULLETS fire four ways at once and hurt
# other ships; MINES are laid behind and hurt anyone who touches one, the
# layer too; FIREBALLS circle the ship and hurt what they touch; the BIG
# SLASH knocks much further; the PAYLOAD is towed on a chain for three
# seconds, then blows up: ships near it are thrown clear and three fires
# are left behind, which hurt and slow anyone who flies into them.
seed 1
game chime
wait 30
cheat race 1
cheat park_cpus
cheat go
# the payload (first, while the stations are still empty): towed, then it blows
cheat power 0 5
expect power0 == 5
botplay 170
expect power0 == 5
botplay 15
expect power0 == 0
expect fires >= 1
cheat idle 1
cheat hp 0 3
# bullets
cheat clear
cheat power 0 1
expect power0 == 1
cheat place 0 60 30
cheat place 1 100 30
cheat vel 0 0 -110
cheat vel 1 0 -110
wait 1
expect shots == 4
wait 14
expect hp1 == 2
expect hp0 == 3
cheat clear
# mines: laid behind, armed after half a second, and not kind to the layer
cheat revive 0
cheat power 0 2
cheat place 0 100 30
cheat vel 0 0 0
cheat face 0 1
cheat hp 0 3
cheat mercy 0 0
wait 11
expect mines >= 1
wait 30
cheat place 0 91 34
cheat vel 0 0 0
wait 2
expect hp0 == 2
# fireballs
cheat clear
cheat power 0 3
cheat hp 1 3
cheat mercy 1 0
cheat place 0 100 30
cheat place 1 114 30
cheat vel 0 0 -60
cheat vel 1 0 -60
wait 2
expect hp1 == 2
# the big slash
cheat clear
cheat power 0 4
cheat place 0 100 30
cheat place 1 114 30
cheat vel 1 0 0
cheat face 0 1
press B
expect vx1 > 1500
expect hp1 == 2
# a plain slash for comparison
cheat clear
cheat power 0 0
wait 30
cheat place 0 100 30
cheat place 1 114 30
cheat vel 1 0 0
press B
expect vx1 < 950
# a fire hurts and slows
cheat clear
cheat hp 1 3
cheat mercy 1 0
cheat fire 160 30
cheat place 1 150 30
cheat vel 1 400 0
wait 4
expect hp1 == 2
expect vx1 < 250
