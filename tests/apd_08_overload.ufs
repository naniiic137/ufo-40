# ANTIPODE: one mod a system is safe, and each damper makes room for one
# more. Past that the system overloads: a FLIP costs 2 armor a flip, a GUN 1
# a shot, and a FRAME takes half again the harm. Two dampers: three a system.
seed 1
game antipode
wait 5
cheat newgame
cheat nofoes
cheat room 2 v
cheat pos 60 134
wait 5
expect safe == 1
# two in the FLIP
cheat mod 0 1
cheat mod 2 1
expect overload1 == 1
press B
press B
expect armor == 73
press B
expect armor == 71
waituntil ground == 1 60
press B
press B
waituntil ground == 1 60
cheat grav 1
cheat pos 60 134
wait 30
# a damper: two are safe
cheat dampers 1
expect safe == 2
expect overload1 == 0
cheat armor 75
press B
press B
expect armor == 75
waituntil ground == 1 60
cheat mod 0 -1
cheat mod 2 -1
cheat dampers 0
cheat grav 1
cheat pos 60 134
wait 30
# two in the GUN: a shot costs 1
cheat mod 0 3
cheat mod 1 3
expect overload3 == 1
cheat armor 75
hold A 1
expect armor == 74
hold A 16
expect armor == 72
release ALL
cheat mod 0 -1
cheat mod 1 -1
# two in the FRAME (KILNSKIN with SATELLITE): half, then half again
cheat mod 0 2
cheat mod 1 2
expect overload2 == 1
cheat armor 75
cheat hurt 20
expect armor == 60
# three in a system with both dampers: safe
cheat dampers 2
cheat mod 2 2
expect overload2 == 0
wait 70
cheat armor 75
cheat hurt 20
expect armor == 65
