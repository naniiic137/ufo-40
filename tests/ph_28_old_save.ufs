# OPEN HOUSE: a save from before OPEN ALL NIGHT (the first layout) is
# carried over: the lists won, the streak and the run in progress.
game openhouse
wait 5
cheat new 2 1
cheat door 0 1
expect n == 2
cheat oldsave 7
reload
game openhouse
wait 30
expect won == 7
expect streak == 2
expect best_streak == 3
expect has_run == 1
expect nbest6 == 0
press A
wait 5
press A
wait 5
expect state == 5
expect scen == 2
expect n == 2
expect night == 1
expect npool == 15
