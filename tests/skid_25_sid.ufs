# SKID KIDS: SID (Edgar's kit). He ignores the centre line (and so can walk
# right up to a rival); his special throw is the POPPER; his move is the
# STOMP.
game skidkids
wait 5
cheat match 9 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 100 100
cheat kid 2 250 100
cheat kid 3 290 170
hold RIGHT 100
expect kx0 > 190
# a toss from point blank knocks the rival flat
cheat give 0 1
cheat kid 0 238 100
hold B 12
waituntil score0 == 1 30
expect kst2 == 5
# the popper
waituntil kst2 == 0 100
cheat clearbags
cheat kid 0 100 100
cheat kid 3 205 112
cheat kid 2 200 100
cheat stars 0 2
cheat give 0 1
hold B 70
waituntil n_boom == 1 90
expect score0 >= 3
# the stomp
waituntil kst2 == 0 100
waituntil kst3 == 0 100
cheat stars 0 2
press A
wait 4
press A
expect kst2 == 5
expect kst3 == 5
