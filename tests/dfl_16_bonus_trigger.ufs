# DRIFTLINE: a stage cleared without losing a car leads to a bonus stage;
# lose one and the road goes straight on. There are three bonus stages,
# after stages 1, 2 and 3, each with its own blocks; there is none after
# stage 4, which leads to the ending. (The bosses are brought on and
# weakened with cheats; the demo player finishes them with real presses.)
game driftline
wait 12
press A
cheat god
cheat boss
waituntil boss_y >= 40 200
cheat bosshp 1
botuntil boss_dead == 1 1500
expect lost_stage == 0
waituntil state == 2 200
waituntil state == 3 300
expect stage == 1
expect blocks_total == 18
expect bonus_played == 1
# the coin falls: on to stage 2
cheat ball 300 170 0 2
waituntil state == 4 200
waituntil state == 1 300
expect stage == 2
# stage 2 with a car lost: no bonus stage
cheat kill
waituntil alive0 == 1 120
expect lost_stage == 1
cheat boss
waituntil boss_y >= 50 300
cheat bosshp 1
botuntil boss_dead == 1 2000
waituntil state == 2 200
waituntil state == 1 300
expect stage == 3
expect bonus_played == 1
# stage 3 clean: the third layout
cheat boss
waituntil revealed == 1 200
cheat bosshp 1
botuntil boss_dead == 1 2000
waituntil state == 3 500
expect blocks_total == 22
expect bonus_played == 2
cheat ball 300 170 0 2
waituntil state == 1 400
expect stage == 4
# stage 4 clean: no bonus stage, the ending
cheat boss
waituntil boss_y >= 36 200
cheat bosshp 1
botuntil boss_dead == 1 2000
expect lost_stage == 0
waituntil state == 6 600
expect bonus_played == 2
expect won == 1
