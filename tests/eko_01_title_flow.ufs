# ECHO UNIT: the title, the story, the briefing room's mission board.
# One player only: the title has no 2-player choice. B leaves for the library.
seed 1
game echounit
wait 20
expect state == 0
expect art_bad == 0
expect layout == 0
expect paused == 0
press A
wait 5
expect state == 1
press A
wait 25
press A
wait 5
# the board: four bats, each READY, the Caldera locked
expect state == 2
expect hq_sel == 0
expect captured0 == 0
expect cleared0 == 0
expect olives0 == 2
expect olives3 == 2
press DOWN
press DOWN
press DOWN
press DOWN
expect hq_sel == 4
wait 15
press A
wait 5
# the Caldera wants all four missions first
expect state == 2
press DOWN
expect hq_sel == 0
press A
wait 5
# Colonel Hush's briefing, then the section card, then play
expect state == 4
expect mission == 0
wait 35
press A
wait 3
expect state == 5
wait 105
expect state == 6
expect mode == 1
expect owl == 0
expect lives == 2
expect hp == 8
expect paused == 0
