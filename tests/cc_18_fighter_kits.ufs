# CUTLASS CUP: every fighter's trick (secondary weapon) and broadside
# (Super Shot).
game cutlass
wait 5
# Mae: a sea urchin, Wall Runner
cheat match 1 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 100
cheat meter 0 4
press B 1
press B 1
expect projs2 == 1
wait 20
hold B
wait 34
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 2
# Greta: a harpoon line; Mirage: one fake per level
cheat match 2 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 100
cheat meter 0 4
press B 1
press B 1
expect projs3 == 1
wait 60
hold B
wait 34
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 3
expect fakes == 1
cheat play
cheat pos 0 60 100
cheat meter 0 4
wait 20
hold B
wait 70
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 3
expect ball_level == 2
expect fakes == 2
expect ball_speed100 < 470
# Silas: the squall, Whirl
cheat match 3 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 100
cheat meter 0 4
press B 1
press B 1
expect projs4 == 1
wait 20
hold B
wait 34
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 4
# Wren: a dart; she blinks and leaves a decoy; Sea Fog
cheat match 4 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 100
cheat meter 0 4
press B 1
press B 1
expect projs5 == 1
wait 20
press A
expect projs7 == 1
expect px0 > 100
cheat pos 0 60 100
hold B
wait 34
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 5
# Bruno: a powder pot, the trident thrust, Plunge
cheat match 5 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 60
cheat meter 0 4
press B 1
press B 1
expect projs6 == 1
wait 30
hold DOWN A 2
expect st0 == 2
wait 20
hold B
wait 34
cheat ball 67 60 0 0
release B
wait 8
expect ball_kind == 6
