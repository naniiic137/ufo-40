# PETAL PARADE: a jar left on the ground ripens a level every 8 seconds, up
# to gold.
game petalparade
wait 20
press A
cheat clear
cheat still
cheat put jar 9 2
expect jar_level == 1
wait 479
expect jar_level == 1
wait 2
expect jar_level == 2
wait 960
expect jar_level == 4
wait 600
expect jar_level == 4
