# DUKES UP: the service lift. Five waves, each waiting on the roof of the
# car and dropping in one at a time; the next wave only comes once the last
# is beaten. After the fifth the doors open on the penthouse.
game dukesup
wait 5
cheat pick 1 0
cheat run 1
cheat god
cheat night 5 2
expect sec == 2
expect lift_wave == 0
wait 45
expect lift_wave == 1
expect kind_1 == 3
expect foe2_state == 13
expect foe2_z > 40
wait 300
expect lift_wave == 1
expect foe2_z == 0
cheat clear
wait 70
expect lift_wave == 2
expect kind_3 == 2
expect kind_1 == 1
cheat clear
wait 70
expect lift_wave == 3
expect kind_9 == 2
cheat clear
wait 70
expect lift_wave == 4
expect kind_10 == 2
expect kind_1 == 2
cheat clear
wait 70
expect lift_wave == 5
expect kind_5 == 2
expect kind_9 == 1
expect kind_10 == 1
cheat clear
wait 70
expect lift_wave == 6
wait 140
expect sec == 3
expect boss_alive == 1
