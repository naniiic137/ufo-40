# ROOFCAT: wasps dart ahead once level with her. A firecracker lights for a
# spirit too, and its cloud hangs about for seven seconds. Old Crab's legs
# rise to three heights, a low one standing up most of the time; every hit
# on its eye counts (two twin shots from the spirit take two), and it is the
# same crab in both loops.
game roofcat
wait 5
cheat area 0 1
cheat cam 0
cheat clear_foes
cheat put 150 115
wait 5
# a wasp at her height: level at once, and fast
cheat dormant wasp 300 114
wait 2
expect sub_wasp == 1
expect x_wasp < 0
wait 10
expect x_wasp > 20
cheat clear_foes
# a wasp high up eases down behind her first
cheat dormant wasp 300 10
wait 10
expect sub_wasp == 0
cheat clear_foes
# a firecracker lights for the spirit as well
cheat kill
waituntil spirit == 1 100
cheat put 100 40
cheat foe cracker 150 112
wait 3
expect sub_cracker == 1
cheat clear_foes
waituntil spirit == 0 300
# the crab's legs
cheat area 4 1
cheat clear_foes
cheat arena
wait 800
expect leg_seen == 7
expect low_up_pct >= 60
# every hit counts: the spirit's twin shots at the eye
cheat kill
waituntil spirit == 1 100
wait 45
expect boss_hp == 35
cheat put 150 120
hold B 3
wait 40
expect boss_hp == 33
