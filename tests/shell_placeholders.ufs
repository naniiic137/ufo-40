# SHELL: an empty slot holds a grey placeholder cartridge for the UFO 50 game
# it is waiting for (COMING SOON, the slot number and the tribute sticker on
# its label; A starts nothing). Slot 40 was the last empty one: with all fifty
# cartridges loaded, no placeholder is left. Every slot, walked one by one,
# holds a real cartridge whose sticker credits its tribute, and the save data
# list still opens on the first cartridge.
wait 30
press A
wait 30
press A
wait 30
expect_scene library
expect library_cursor == 0
# a real cartridge credits its own tribute
expect library_placeholder == 0
expect library_sticker_has.TRIBUTE_TO_BARBUTA == 1
expect library_sticker_has.UFO_50_#1 == 1
# every slot, one by one
expect library_cursor == 0
expect library_placeholder == 0
expect library_sticker_has.TRIBUTE == 1
expect library_sticker_has.UFO_50_#1 == 1
press RIGHT
