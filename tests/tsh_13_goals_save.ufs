# TILTSHOT: goals and saving. A hole in one lights the Beacon at once (here
# on Toss-Up, the par-1 hole, with real presses); the cartridge saves its
# records and goals, which come back after the console is switched off and
# on. Nothing else is saved mid-round: a new start is a new tournament.
seed 13
game tiltshot
wait 30
expect save.tiltshot == 0
cheat hole 9
botuntil holed == 1 3000
expect strokes == 1
expect goals == 1
expect aces == 1
expect save.tiltshot > 0
wait 200
reload
expect goals.tiltshot == 1
game tiltshot
wait 30
expect state == 0
expect aces == 1
expect goals == 1
expect used & 1
# the records screen
press DOWN
press DOWN
press DOWN
press A
wait 15
expect state == 2
press B
wait 15
expect state == 0
# B on the title goes back to the library
press B
wait 60
expect_scene library
