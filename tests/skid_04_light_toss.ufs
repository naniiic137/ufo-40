# SKID KIDS: a light tap-and-let-go is a short lob that lands by the
# thrower's feet and stops there, to be picked up again at once. The window
# is the same for every kid: let go before 20 frames of B is a toss, later
# is a throw, for the quick wind-up kid too.
game skidkids
wait 5
cheat match 0 5 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 80 100
cheat give 0 1
hold B 12
wait 1
expect n_toss == 1
expect n_throw == 1
expect bagst0 == 3
expect bagz0 > 5
wait 40
expect bagst0 == 1
expect bagx0 > 90
expect bagx0 < 112
hold RIGHT 19
press B
wait 16
expect held0 == 1
# NOODLE (a full wind-up in 60 frames) and SPARKY (30): 19 frames tosses, 20 throws
cheat match 0 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 80 100
cheat give 0 1
hold B 19
wait 1
expect n_toss == 1
expect n_throw == 1
cheat match 0 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 80 100
cheat give 0 1
hold B 20
wait 1
expect n_toss == 0
expect n_throw == 1
cheat match 4 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 80 100
cheat give 0 1
hold B 19
wait 1
expect n_toss == 1
expect n_throw == 1
cheat match 4 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 80 100
cheat give 0 1
hold B 20
wait 1
expect n_toss == 0
expect n_throw == 1
