# BELLHOP: three hidden warps. On A-1, C-7 and D-3 a little sparkle shows
# for five seconds from the moment the stage loads (the bubble and a crash
# don't stop the clock); flying into it in time skips ahead (A-1 to A-6,
# C-7 to C-10, D-3 to D-8), and the skipped stages' tea with them. The
# demo pilot takes all three with real presses.
seed 1
game bellhop
wait 20
cheat stage 0
wait 2
expect warp_shown == 1
wait 290
expect warp_shown == 1
wait 10
expect warp_shown == 0
# a crash doesn't restart the clock
cheat stage 0
wait 2
cheat place 160 26
hold A 20
expect mode == 2
wait 80
expect mode == 0
expect warp_shown == 1
wait 200
expect warp_shown == 0
# no warp on other stages
cheat stage 1
wait 2
expect warp_shown == 0
# taken
cheat bot_warps 1
cheat stage 0
wait 2
botuntil stage != 0 600
expect stage == 5
expect tea == 0
cheat stage 26
wait 2
botuntil stage != 26 600
expect stage == 29
cheat stage 32
wait 2
botuntil stage != 32 600
expect stage == 37
