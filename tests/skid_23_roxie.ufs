# SKID KIDS: ROXIE (Suze's kit). She runs faster and never slips; her
# special throw is the COMET; her move is the GUST.
game skidkids
wait 5
cheat match 7 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 30 100
hold RIGHT 30
expect kx0 >= 68
cheat puddle 100 140
cheat kid 0 60 140
hold RIGHT 40
expect n_slip == 0
expect kst0 == 0
expect kx0 > 100
# the comet
cheat kid 0 100 100
cheat kid 2 230 108
cheat stars 0 2
cheat give 0 1
hold B 70
wait 2
expect bagkind0 == 1
waituntil score0 == 1 60
# the gust
waituntil kst2 == 0 100
cheat clearbags
cheat kid 2 220 150
cheat loose 130 150
cheat stars 0 2
press A
wait 4
press A
waituntil score0 == 2 150
