# TURNIP TRUCK: RADISH RING. Black getaway cars flee police cars all over
# town (three of each round the truck); a gang car close to the truck
# shoots at it, badly. A bullet that lands costs a heart.
seed 8
game turnip
wait 5
cheat day 3 4
waituntil gangs >= 3 3000
waituntil police >= 3 600
cheat notraffic
cheat pos 400 276
cheat stop
cheat car 1 11 5 2
waituntil shots_0 >= 1 90
# a bullet on target
cheat clearmobs
cheat inv 0
cheat shot 0 370 276 2.4 0 40
wait 20
expect hit_by3 == 1
expect hearts == 2
# the police stay on their gang car's tail
cheat notraffic
waituntil pair_gap >= 0 600
wait 300
expect pair_gap >= 0
expect pair_gap < 160
