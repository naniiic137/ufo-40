# RIMSHIRE: nothing knocks a menhir about (it moves only when launched),
# so a hit bounces off it.
game rimshire
cheat war 1
cheat cpu 1 -1
cheat army 0 W
cheat army 1 M
cheat battle 6 1 0
cheat field 0
cheat unshuffle
cheat place 0 100 128
cheat place 1 160 128
waituntil bphase == 1 200
press A
hold RIGHT 40
hold A 36
wait 1
waituntil moving == 0 600
expect d1_x == 160
expect d1_y == 128
expect d1_hp == 6
expect d0_x < 150
