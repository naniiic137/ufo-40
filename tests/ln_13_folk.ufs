# LOST LINKS: talking is rolling into somebody: the folk say one of their
# one or two lines. A stray rolled into joins Dimple (and the strokes are
# refilled, as for anything found). The odd tree and the crashed saucer
# have something to say too.
game lostlinks
wait 5
cheat newgame
cheat no_slicers
cheat ball 0 70 41
cheat aim 48
hold A 10
wait 1
waituntil state == 3 200
wait 15
press A
waituntil moving == 0 300
# a stray
cheat strokes 3
cheat ball 0 114 29
cheat aim 48
hold A 14
wait 1
waituntil strays == 1 200
expect strokes == 20
wait 15
press A
waituntil moving == 0 300
# the odd tree
cheat ball 0 17 28
cheat aim 48
hold A 10
wait 1
waituntil secrets == 1 200
wait 15
press A
waituntil moving == 0 300
# the saucer in the dunes
cheat ball 0 130 67
cheat aim 48
hold A 14
wait 1
waituntil secrets == 3 200
reload
game lostlinks
wait 5
expect strays == 1
expect secrets == 3
