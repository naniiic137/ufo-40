# WET PAINT: a garage flashes before it opens and sends out a load of 2 or
# 3 foes, a little apart. Once they are all gone it rests, then flashes and
# sends the next.
game wetpaint
wait 5
cheat course 1
cheat noclock
cheat go
cheat car 0 0 3
expect garages == 1
expect garage0 == 0
wait 62
expect garage0 == 1
wait 60
expect foes == 1
wait 30
expect foes == 2
expect garage0 == 3
cheat killall
wait 2
expect garage0 == 0
wait 180
expect garage0 == 1
wait 90
expect foes == 2
