# WITHERLEA: upstairs and the cellar are dark. The stairs won't take you up
# without a light: the hurricane lamp, filled with paraffin and lit with a
# match. Lit, every dark room is a ring of light round the hand and black
# beyond it.
game witherlea
wait 5
cheat new
cheat spawn 99999
cheat room hall
expect live_S_HALL_STAIRS == 0
cheat aim S_HALL_STAIRS_DARK
press A
expect talking == 1
expect room == 3
cheat hush
cheat give lamp
cheat give paraffin
cheat give matches
# the dry lamp
cheat hold lamp
press A
expect flag_F_STAIRS_LIT == 0
cheat hush
# a match to a dry wick does nothing
cheat hold matches
press B
press LEFT
press LEFT
press A
expect flag_F_LAMP_LIT == 0
expect has_matches == 1
cheat hush
# paraffin in, from the bag, then the match
press A
expect held == 20
press B
press RIGHT
press A
expect flag_F_LAMP_FILLED == 1
expect has_paraffin == 0
cheat hush
press RIGHT
press A
expect held == 16
press B
press LEFT
press LEFT
press A
expect flag_F_LAMP_LIT == 1
cheat hush
press B
expect scene == 3
cheat hold lamp
cheat aim S_HALL_STAIRS_DARK
press A
expect flag_F_STAIRS_LIT == 1
expect has_lamp == 0
cheat hush
expect live_S_HALL_STAIRS == 1
press A
wait 24
expect room == 21
expect dark == 1
cheat cursor 160 70
wait 2
shot wth_dark_landing
# the cellar needs the light as well
cheat new
cheat spawn 99999
cheat room drive
cheat set F_HATCH_OPEN
cheat aim S_DRV_CELLAR
press A
wait 30
expect room == 17
expect talking == 1
cheat hush
cheat set F_STAIRS_LIT
press A
wait 24
expect room == 29
expect dark == 1
