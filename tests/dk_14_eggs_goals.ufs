# DUSKLING: every egg is an ending. The first one earns the Saucer (FIND AN
# EGG); the three eggs, found over as many runs as it takes, earn the Alien.
game duskling
wait 5
cheat room 21
hold A 200
expect state == 4
expect egg_got == 0
expect eggs == 1
expect goals & 2
expect goals !& 4
wait 220
press A
wait 10
expect state == 0
# the amber egg on another run
cheat room 28
cheat pos 1570 61
hold A 60
expect state == 4
expect egg_got == 1
expect eggs == 3
expect goals !& 4
# and the rose egg
cheat room 36
cheat pos 215 111
hold A 100
expect state == 4
expect egg_got == 2
expect eggs == 7
expect goals & 4
reload
game duskling
wait 5
expect eggs == 7
expect goals & 7
