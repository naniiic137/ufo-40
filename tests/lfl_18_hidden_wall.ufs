# LANDFALL: one hidden wall per planet, on one of four room looks of our
# own that the hint names (a cross of five plants, three crystals in a
# slant, a hut fallen to pieces, a zigzag of bushes), with four of the
# rare resource behind it. Its key is rolled per planet: the thumper, the
# disc (thrown from the side the hint says), a blast pod, rivets, or being
# small enough to slip in. The wrong tool does nothing.
game landfall
wait 5
cheat nomobs
# planet 1, the cross of plants: a thump wakes it
cheat planet 1
expect secret_room == 12
expect secret_key == 0
expect secret_look == 0
cheat room 12 243 67
expect tile_13_4 == 18
cheat hold 1 4
cheat face 3
press A
wait 20
expect secret_open == 0
press B 3
cheat res 1 2
press A
expect secret_open == 1
expect tile_13_4 == 0
expect res1 == 1
hold LEFT 40
expect res1 == 5
# planet 14, the zigzag of bushes: rivets crack it (from the west)
cheat planet 14
expect secret_key == 3
expect secret_look == 3
cheat room 20 19 67
cheat hold 1 -1
cheat face 1
expect tile_3_4 == 18
press A
wait 20
expect tile_3_4 == 0
expect res3 == 0
hold RIGHT 40
expect res3 == 4
# planet 12, the fallen hut: a blast opens it (from the south)
cheat planet 12
expect secret_key == 2
expect secret_look == 2
cheat room 39 211 83
expect tile_13_4 == 18
cheat hold 3 5
cheat res 1 5
press A
hold DOWN 30
wait 90
expect tile_13_4 == 0
hold UP 60
expect res0 == 4
# planet 3, the slanted crystals: the disc, thrown from the east
cheat planet 3
expect secret_key == 1
expect secret_look == 1
cheat room 28 147 67
cheat hold 0 -1
cheat face 3
expect tile_6_4 == 18
press A
wait 60
expect tile_6_4 == 0
hold LEFT 60
expect res2 == 4
# planet 2: only a small Wick gets in
cheat planet 2
expect secret_key == 4
cheat room 32 243 67
cheat hold 2 -1
cheat face 3
expect tile_13_4 == 18
hold LEFT 30
expect px == 224
cheat face 1
press A
waituntil small == 1 120
expect res3 == 0
hold LEFT 60
expect px < 220
expect tile_13_4 == 18
expect res3 == 4
