# CHIME CIRCUIT: track 4 can be finished. The demo pilot flies player one's
# ship with real button presses (steer, thrust, slash) for all eight laps,
# against the five CPU pilots, who race too.
seed 14
game chime
wait 30
cheat race 4
expect track == 3
expect map_ok == 1
botuntil fin0 == 1 30000
expect laps0 == 8
expect place0 >= 1
expect cpu_laps >= 8
