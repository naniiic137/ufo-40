# FORLORN HOPE: keys are all alike and counted at the top left; walking into
# a locked door with a key opens it for good (the key is used up); without
# one the door holds. Thornkeep's gate is the first.
game forlorn
cheat start 1
wait 20
cheat no_foes
cheat class 0
wait 2
cheat place 725 195
wait 3
hold RIGHT 30
expect x <= 737
expect tile18074 == 10
expect keys == 0
cheat keys 1
hold RIGHT 30
expect tile18074 == 11
expect tile19074 == 11
expect keys == 0
expect doors == 1
expect x >= 750
cheat die
wait 60
expect tile18074 == 11
expect doors == 1
