# DRIFTLINE: the title offers 1 PLAYER and 2 PLAYERS (UP/DOWN), A starts,
# B goes back to the library. A run starts on stage 1, Harbour Road, with
# the car in play and three in reserve, no score, and the stage's name
# shown before the first foes come. A run is not saved: leave in the
# middle and the cartridge opens on its title again.
game driftline
wait 5
expect state == 0
expect paused == 0
expect sel == 0
press DOWN
expect sel == 1
press DOWN
expect sel == 0
press UP
expect sel == 1
press UP
expect sel == 0
press A
expect state == 1
expect players == 1
expect stage == 1
expect spare == 3
expect alive0 == 1
expect on1 == 0
expect score == 0
expect foes == 0
wait 200
expect foes > 0
# START pauses in a run
press START
expect paused == 1
press DOWN
press DOWN
press DOWN
press DOWN
press DOWN
press A
wait 60
expect_scene library
game driftline
wait 5
expect_scene runner
expect state == 0
expect score == 0
# B on the title leaves
press B
wait 60
expect_scene library
