# SKID KIDS: a juice box is drunk on the spot for half a star, and only with
# empty hands. One the Coach throws in that lands on a kid knocks it down,
# for no point.
game skidkids
wait 5
cheat match 0 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 100 100
cheat juice 104 100
press B
wait 16
expect n_drink == 1
expect stars0 == 1
expect juice == 0
# with a bag in hand B passes instead
cheat juice 104 100
cheat give 0 1
press B
expect n_pass == 1
expect n_drink == 1
expect juice == 1
# the Coach's juice box on your head
cheat ctrl 0 0
cheat clearbags
cheat kid 0 100 100
cheat coachthrow 1 100 100
wait 45
expect kst0 == 5
expect score0 == 0
expect score1 == 0
