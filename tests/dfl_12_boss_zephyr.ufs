# DRIFTLINE: stage 1's boss, the Zephyr, an airship seen far off all
# stage. It comes down at the end with three turrets under it; only the
# turrets can be hurt (the gasbag soaks up shots), one at a time, and it
# falls when all three are gone: 10,000 points.
game driftline
wait 12
press A
cheat boss
waituntil boss_on == 1 10
expect boss_kind == 0
expect part_hp0 == 80
expect part_hp1 == 80
expect part_hp2 == 80
waituntil boss_y >= 40 200
cheat god
cheat bossstill
cheat meter 700
# under the gasbag, between the turrets: nothing gets through
cheat pos 136
hold UP 30
hold B 60
expect part_hp0 == 80
expect part_hp1 == 80
expect boss_hp == 240
# under the middle turret
cheat pos 160
hold B
waituntil part_hp1 <= 0 200
release
expect boss_dead == 0
expect score == 0
cheat parthp 0 0
expect boss_dead == 0
# the last one
cheat pos 208
hold B
waituntil boss_dead == 1 200
release
expect score == 10000
# then the stage is clear
waituntil state == 2 200
