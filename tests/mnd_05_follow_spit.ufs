# MANDIBLES: soldiers on Follow spit whenever you do, mostly the way you
# face (now and then one spits the way it happens to face), so a stack of
# five and you put six spits into one red ant at once. Blue soldiers on
# Halt pick a direction and keep it, like the red ones.
game mandibles
wait 5
cheat mission 1 14
cheat clear
cheat red_store 0
cheat store 0
cheat at 160 60
cheat unit 3 0 156 60
cheat unit 3 0 156 62
cheat unit 3 0 158 58
cheat unit 3 0 154 60
cheat unit 3 0 156 64
hold A
press RIGHT
press RIGHT
release A
wait 2
expect follow == 5
expect shots == 0
press B
expect shots == 6
wait 40
# a red worker with six health, lined up east of the stack: one volley
cheat mistakes 0
cheat at 160 60
cheat tag_at 0 150 60
cheat tag_at 1 152 60
cheat tag_at 2 154 60
cheat tag_at 3 156 61
cheat tag_at 4 158 59
cheat unit 2 1 196 60
press B
wait 30
expect t5_alive == 0
expect kills == 1
# a halted soldier locks on the first ant it spits at
hold A
press LEFT
release A
wait 2
cheat unit 2 1 190 20
wait 20
expect t0_lock >= 0
