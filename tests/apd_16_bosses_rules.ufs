# ANTIPODE: a fight starts when the suit walks into the arena; its doors
# shut until it is over and a health bar shows. A spare body that takes over
# finds the boss with only 250 back. The four cipher holders give a cipher
# each when beaten (after their chain of blasts, the doors open again); the
# two minor ones give nothing. A beaten boss stays beaten.
seed 1
game antipode
wait 5
cheat newgame
cheat room 0 W
wait 5
expect boss == 1
expect boss_on == 0
hold RIGHT 10
expect boss_on == 1
expect boss_lock == 1
expect boss_max == 600
expect boss_hp == 600
expect tileat_8_70 == 10
cheat bosshp 100
cheat die
waituntil state == 3 100
expect px > 44
expect boss_hp == 350
expect boss_on == 1
expect spares == 1
cheat killboss
expect boss_on == 0
expect boss_dead1 == 1
expect ciphers == 0
wait 110
expect boss_lock == 0
expect ciphers == 1
expect tileat_8_70 == 8
# back again: no fight
cheat room 0 W
hold RIGHT 40
expect boss_on == 0
# the Scrapper, a minor one: no cipher
cheat room 0 M
wait 5
hold RIGHT 20
expect boss_on == 1
expect boss == 0
expect boss_max == 300
cheat killboss
wait 110
expect ciphers == 1
expect boss_dead0 == 1
