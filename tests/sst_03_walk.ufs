# SHOWSTOPPER: Clover walks eight ways at one pace, 1.25 px a frame
# straight and the same speed on the diagonals (0.88 px on each axis);
# walls stop her; on ice she slides.
game showstopper
wait 5
cheat run
cheat arena
cheat god
expect px == 168
expect py == 3160
hold RIGHT 16
expect px == 188
expect py == 3160
hold LEFT 16
expect px == 168
hold UP 16
expect py == 3140
hold UP RIGHT 16
expect px == 182
expect py == 3125
hold DOWN LEFT 16
expect px == 168
expect py == 3140
# a wall: the trees on the left edge
cheat pos 40 3160
hold LEFT 60
expect px >= 21
expect px <= 22
# ice: she keeps sliding after the pad is let go
cheat cam 180
cheat arena
cheat pos 88 264
hold RIGHT 30
wait 1
print px
expect px > 105
hold LEFT 1
wait 10
expect px > 112
