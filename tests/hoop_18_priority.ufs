# HOOPLA: when shots meet. Most pass each other (GULP's aimed dart too);
# GULP's fast dart knocks every other shot out except COLLIER's charge.
seed 18
game hoopla
wait 30
cheat match 7 0 0
cheat dummy
cheat go
cheat noring
cheat noledges
cheat pos 0 40 152
cheat pos 1 280 152
cheat face 0 1
wait 2
# two plain shots pass
cheat shot 5 0 100 100 1024 0
cheat shot 5 1 120 100 -1024 0
wait 6
expect shots5 == 2
waituntil shots5 == 0 120
# the aimed dart passes a knife
cheat shot 9 0 100 100 900 0
cheat shot 0 1 120 100 -1024 0
wait 6
expect shots9 == 1
expect shots0 == 1
cheat noring
waituntil shots9 == 0 120
waituntil shots0 == 0 300
# a fast dart knocks a knife out and flies on
press UP A
press P2A
waituntil shots0 == 0 60
expect shots10 == 1
waituntil f1_inv > 0 60
# a charge beats the fast dart
cheat match 7 5 0
cheat dummy
cheat go
cheat noring
cheat noledges
cheat shot 10 0 100 100 1800 0
cheat shot 7 1 106 100 0 0
wait 2
expect shots10 == 0
expect shots7 == 1
