# GRUB SHIFT: a hit fizz pod explodes, chains into its neighbour, and a
# blast next to Tilly ends the contract.
game grubshift
wait 5
cheat contract 1 7
cheat clear
cheat pods 3 2 1
cheat pods 4 2 1
cheat bug 5 2 1 0
cheat bug 5 3 3 0
cheat use 5 4 2
expect kills == 2
expect status == 2
wait 80
expect state == 4
expect streak == 0
