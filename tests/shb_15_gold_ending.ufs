# SHUTTERBUG: beating King Thunderjaw without all three letters: the
# Saucer goal, the ending, and a hint at what's missing; then the credits,
# the records saved, and the title.
game shutterbug
cheat run 1
cheat letters 3
cheat win
wait 30
expect state == 7
expect won == 1
expect true_won == 0
expect goals & 2
expect goals !& 4
wait 900
expect state == 8
# the credits: every foe kind by name; a picture only for those photographed
expect cast == 31
expect cast_pictured == 0
waituntil state == 0 4000
expect save_wins == 1
expect save_trues == 0
