# FENNEC FOUNTAIN: the water stone on the spring clears the room and earns
# a drop; drops are saved.
game fennec
wait 30
cheat room 1
expect state == 2
cheat solve
expect state == 3
expect drops == 1
wait 110
expect state == 1
expect done1 == 1
reload
game fennec
wait 5
expect drops == 1
expect done1 == 1
expect done2 == 0
