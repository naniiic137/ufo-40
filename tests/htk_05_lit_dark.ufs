# HAT TRICK: the lit ball. Touching it lights it (white); it goes dark only
# once a loose ball has come to rest (on the ground and all but still for a
# second: bouncing, rolling along or falling it stays lit), or when it is
# carried too long (3 s) without a kick, and a dark ball ends the chain. A
# touch before it settles keeps it lit; a ball still falling (down a hole,
# round through the wrap) stays lit.
game hattrick
wait 5
cheat level 1
cheat skipintro
cheat still
cheat god
cheat pos 0 140 160
cheat carry 0
cheat combo 2
wait 2
press B 1
expect lit == 1
expect combo == 2
waituntil ball_bounces == 1 120
expect lit == 1
waituntil ball_bounces == 2 120
expect lit == 1
expect combo == 2
# the third bounce is not the end: still in the air, still lit
waituntil ball_bounces == 3 120
expect lit == 1
expect ball_ground == 0
expect combo == 2
# only when it lies still on the ground, a second later
waituntil ball_ground == 1 120
expect lit == 1
waituntil lit == 0 400
expect ball_ground == 1
expect ball_rest >= 60
expect combo == 0
# dropped from high up: it bounces on and on, lit all the while
cheat pos 0 300 160
cheat ball 100 30 0 0
cheat light
waituntil ball_bounces == 3 300
expect lit == 1
expect ball_ground == 0
waituntil ball_ground == 1 300
expect lit == 1
wait 30
expect lit == 1
wait 35
expect lit == 0
# rolling along the ground: fast, it stays lit; slowed to a stop and left
# there a second, it goes dark
cheat pos 0 60 160
cheat carry 0
cheat combo 1
wait 2
hold DOWN
press B 1
release
expect lit == 1
waituntil ball_ground == 1 30
wait 65
expect ball_ground == 1
expect ball_vx100 > 30
expect ball_rest == 0
expect lit == 1
expect combo == 1
waituntil lit == 0 300
expect ball_vx100 < 30
expect combo == 0
# carried too long
cheat pos 0 140 160
cheat carry 0
cheat combo 3
wait 170
expect lit == 1
expect combo == 3
wait 15
expect lit == 0
expect combo == 0
# a kick lights it again, but the chain starts over
press B 1
expect lit == 1
expect combo == 0
# kept alive: a header before it settles (two bounces already)
cheat pos 0 300 160
cheat ball 300 74 0 0
cheat light
cheat bounces 2
wait 3
hold A 11
hold A B 2
wait 10
expect ball_bounces == 0
expect ball_vy100 < 0
expect lit == 1
# a ball falling through the wrap stays lit: down a hole in the floor, in
# at the top, and on down to a ledge
cheat level 5
cheat skipintro
cheat still
cheat god
cheat ball 60 150 0 1
cheat light
waituntil ball_y < 40 60
expect lit == 1
expect ball_bounces == 0
