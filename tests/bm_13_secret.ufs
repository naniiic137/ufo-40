# BOOMTOWN: a secret. Light the fuse when the clock reads 5:55 and a message
# appears; a second either side, nothing.
seed 23
game boomtown
wait 20
press A
wait 15
press A
wait 100
cheat clear
cheat put folk 0 0
cheat put piece 5 4 5
cheat clock 354
press RIGHT
press RIGHT
press RIGHT
press A
cheat cursor 5 4
press A
expect secret == 0
waituntil state == 7 300
press A
waituntil state == 3 200
cheat clear
cheat put folk 0 0
cheat put piece 5 4 5
cheat clock 355
press RIGHT
press RIGHT
press RIGHT
press A
cheat cursor 5 4
press A
expect secret > 0
