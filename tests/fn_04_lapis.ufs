# FENNEC FOUNTAIN: lapis never moves for the fennec, only for a block of an
# equal or higher number; a lapis block pushed into a 1 against a wall takes
# it in like any block.
game fennec
wait 5
cheat setroom #########/#K.b....#/#########
press RIGHT
wait 12
press RIGHT
wait 12
expect px == 2
expect tile31 == 22
cheat setroom #########/#K.2b...#/#########
press RIGHT
wait 12
press RIGHT
wait 12
expect tile41 == 12
expect tile51 == 22
# a 1 can't push a lapis 2
cheat setroom #########/#K.1b...#/#########
press RIGHT
wait 12
press RIGHT
wait 12
expect px == 2
expect tile41 == 22
# a lapis 1 that can move is pushed; against a wall it is taken in
cheat setroom #########/#K.3a...#/#########
press RIGHT
wait 12
press RIGHT
wait 12
expect tile41 == 13
expect tile51 == 21
cheat setroom #######/#K.3a#/#######
press RIGHT
wait 12
press RIGHT
wait 12
expect tile41 == 14
expect nb == 1
