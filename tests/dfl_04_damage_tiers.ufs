# DRIFTLINE: the meter sets how hard every shot hits, by its section only:
# grey 1, green 2, red 4. A fuller red is no stronger than a bare red.
game driftline
wait 12
press A
cheat nospawn
wait 10
cheat pos 160
hold UP 30
# a kite that holds still at 160,60
cheat dummy 0 160 60
expect kind_hp_0 == 1000
cheat meter 100
press B
wait 30
expect last_hit_dmg == 1
expect kind_hp_0 == 999
cheat meter 300
press B
wait 30
expect last_hit_dmg == 2
expect kind_hp_0 == 997
cheat meter 520
press B
wait 30
expect last_hit_dmg == 4
expect kind_hp_0 == 993
cheat meter 720
press B
wait 30
expect last_hit_dmg == 4
expect kind_hp_0 == 989
# the side guns hit by the meter too
cheat meter 520
cheat dummy 2 220 157
press A
wait 30
expect kind_hp_2 == 996
