waituntil state == 6 200
cheat winmatch
wait 2
wait 25
press A
waituntil state == 6 200
cheat winmatch
wait 2
wait 25
press A
waituntil state == 6 200
cheat winmatch
wait 2
expect state == 12
expect end_kind == 0
expect end_note == 0
