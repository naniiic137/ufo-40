# SHOWSTOPPER: the secret hand. Taking a red card, then a blue, then a
# green as one hand flashes the code FREE-RIDE and opens FREE RIDE on the
# title: the Hop for practice, three tries, no lives won, the best coins
# kept. The hand itself is still three different cards: nothing.
game showstopper
wait 5
expect free_ride == 0
expect menu_rows == 2
cheat run
cheat arena
cheat card 4
cheat card 5
cheat card 2
expect code_t > 0
expect hand_res == 0
expect free_ride == 1
reload
game showstopper
wait 5
expect menu_rows == 3
press DOWN
press DOWN
expect menu == 2
press A
expect state == 6
expect hop_practice == 1
expect hop_tries == 3
botuntil hop_mark >= 1 3000
expect lives == 0
expect hop_lives == 0
expect goals == 0
# another order is no secret
reload
game showstopper
wait 5
cheat run
cheat card 2
cheat card 5
cheat card 4
expect code_t == 0
