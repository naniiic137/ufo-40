# GRUB SHIFT: the greedy autoplay bot can win contract 1 on a fixed seed
# (proves a full contract is playable end to end), and wins at least a
# third of 20 seeded contracts (balance smoke test).
game grubshift
wait 5
cheat contract 1 1000
cheat autoplay
expect status == 1
expect kills >= 18
expect botwins20 >= 7
