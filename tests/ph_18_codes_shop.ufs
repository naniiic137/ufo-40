# OPEN HOUSE: every Random list has a six-digit code; typing the same code
# in deals the same list again (and doesn't count for the streak). A on the
# Random tile offers DEAL A NEW LIST or TYPE A CODE. The shop is a grid of
# guest cards, five to a row, over SPACE / GUEST BOOK / NEXT PARTY, and
# every move wraps.
game openhouse
wait 5
cheat won 63
cheat menu
wait 2
press DOWN
press LEFT
expect scen_sel == 5
press A
wait 2
expect state == 18
press DOWN
press A
wait 2
expect state == 17
press UP
press RIGHT
press UP
press UP
press A
wait 2
expect state == 3
expect code == 120000
expect typed == 1
# (the deal for a code changed once when the owner's two guests joined the
# Random candidates; this one now deals the ALBATROSS, pool8 == 47)
expect npool == 15
expect pool2 == 4
expect pool3 == 11
expect pool8 == 47
expect pool13 == 42
expect pool14 == 38
# again: the box starts on the last code
cheat menu
wait 2
press A
press DOWN
press A
wait 2
expect state == 17
press A
wait 2
expect code == 120000
expect pool2 == 4
expect pool13 == 42
# a dealt list shows its own code
cheat menu
wait 2
press A
wait 2
expect state == 18
press A
wait 2
expect state == 3
expect typed == 0
expect code >= 0
expect code < 1000000
# the shop grid (scenario 1 deals 15 guests: three rows of five)
cheat new 1 1
cheat door 0
cheat end
cheat next
expect state == 13
expect npool == 15
expect shopcur == 0
expect shoptype == 0
press RIGHT
expect shopcur == 1
expect shoptype == 1
# LEFT and RIGHT go round the row
press LEFT
press LEFT
expect shopcur == 4
press RIGHT
expect shopcur == 0
press DOWN
expect shopcur == 5
expect shoptype == 7
press DOWN
expect shopcur == 10
# down from the last row: the button below, SPACE under the first column
press DOWN
expect shopcur == 15
expect shoptype == -1
# the buttons run SPACE, GUEST BOOK, NEXT PARTY and round again
press RIGHT
expect shopcur == 17
press RIGHT
expect shopcur == 16
press RIGHT
expect shopcur == 15
# up goes back to the last row of cards, above the button
press UP
expect shopcur == 10
press RIGHT
press RIGHT
press RIGHT
press RIGHT
expect shopcur == 14
expect shoptype == 37
press RIGHT
expect shopcur == 10
# the guest book opens and closes back into the shop
press DOWN
press RIGHT
expect shopcur == 17
press A
wait 2
expect state == 16
press B
wait 2
expect state == 13
# NEXT PARTY
press RIGHT
expect shopcur == 16
press A
wait 2
expect state == 5
expect night == 2
