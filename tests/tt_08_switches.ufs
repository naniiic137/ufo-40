# TINTAIL: the sun pad dries the switch grass (it turns sand-coloured) and
# the rain pad wets it (green).
game tintail
wait 5
cheat level 10
expect sw == 0
expect colour1305 == 1
cheat act DDDRR
expect sw == 2
expect colour1305 == 2
cheat level 12
expect colour0804 == 2
cheat act DDDDR
expect sw == 1
expect colour0804 == 1
