# TUSKWIND: the brawl, for two players. Pick best of 1, 3, 5, 7 or 9
# rounds. Each round is a new single screen that wraps at the sides; both
# walruses jump, aim and flap exactly as on the journey (no items), and a
# walrus coming in fast knocks the other one flying. After a while the
# islets start to crumble away one by one. The one left out of the sea
# takes the round; both in at once and it is played again.
game tuskwind
wait 20
press DOWN
press A
wait 2
expect state == 8
expect rounds == 3
press LEFT
expect rounds == 1
press LEFT
expect rounds == 1
press RIGHT
press RIGHT
press RIGHT
press RIGHT
expect rounds == 9
press RIGHT
expect rounds == 9
press B
wait 2
expect state == 0
wait 20
press A
wait 2
expect state == 8
press LEFT
press LEFT
press LEFT
expect rounds == 3
wait 10
press A
wait 2
expect state == 9
expect round_no == 1
expect wins0 == 0
expect wins1 == 0
expect bmode0 == 0
expect bmode1 == 0
expect bx0 < 160
expect bx1 > 160
# a press the other way turns a walrus first, as on the journey
press LEFT 1
expect bx0 == 58
# player 2 has his own buttons
hold P2LEFT 20
expect bx1 < 252
# the same jump as the journey
hold A 31
wait 1
expect bmode0 == 1
# a fast walrus sends the other one flying
cheat brawlpos 0 150 60
cheat brawlpos 1 162 60
cheat brawlvel 0 3 0
cheat brawlvel 1 0 0
wait 2
expect bmode1 == 1
expect bvx10_1 > 20
# the screen wraps
cheat brawlpos 0 3 40
cheat brawlvel 0 -2 0
wait 3
expect bx0 > 300
# the islets crumble
cheat crumble 600
wait 2
expect solid_plats == 8
wait 92
expect solid_plats == 7
# player 2 into the sea: player 1 takes the round
cheat brawlpos 1 160 190
waituntil state == 10 60
expect round_winner == 0
expect wins0 == 1
waituntil state == 9 200
expect round_no == 2
expect solid_plats == 8
# both in at once: the round is played again
cheat brawlpos 0 100 190
cheat brawlpos 1 200 190
waituntil state == 10 60
expect round_winner == -1
expect wins0 == 1
expect wins1 == 0
waituntil state == 9 200
expect round_no == 2
# player 1 again: two of three, the brawl is won
cheat brawlpos 1 160 190
waituntil state == 10 60
expect wins0 == 2
waituntil state == 11 200
wait 70
press A
wait 2
expect state == 8
