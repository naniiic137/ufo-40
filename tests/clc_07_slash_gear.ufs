# CLARION CALL: the slash and the ship's gear. B slashes to the side the
# ship last steered (2 damage); a flitter (2) goes in one, drops its coins,
# and the coins are picked up by touch. The slash breaks coin blocks in the
# walls (10 coins). Sentries are proof against the ship. The Twin Swipe
# slashes both ways at once; the Seeker Bells launch a homing bell with
# each slash (two at most); the Bounce Beam a ricocheting beam; the Spit
# Gun a short shot; the Fuel Siphon gives 100 fuel a kill made by the ship;
# the Penny Purse makes drops half again bigger (rounded up).
seed 1
game clarion
wait 10
cheat area 6 2
wait 2
cheat no_foes
cheat place 180 120
cheat vel 0 0
cheat face 1
cheat ent 1 194 120
press B 1
wait 2
expect count1 == 0
expect count26 == 1
cheat goto_kind 26
wait 2
expect coins == 3
# behind the ship, nothing
cheat place 180 120
cheat vel 0 0
cheat face 1
cheat ent 1 166 120
wait 20
press B 1
wait 2
expect count1 == 1
cheat no_foes
# a coin block in the wall
wait 20
cheat tile 25 15 3
cheat place 190 120
cheat vel 0 0
cheat face 1
press B 1
wait 2
expect coins == 13
# a sentry shrugs it off
wait 20
cheat place 180 120
cheat vel 0 0
cheat face 1
cheat ent 11 194 120
press B 1
wait 2
expect count11 == 1
cheat no_foes
# the twin swipe: both sides
cheat gear 0
wait 20
cheat place 180 120
cheat vel 0 0
cheat ent 1 194 120
cheat ent 1 168 120
press B 1
wait 2
expect count1 == 0
# the fuel siphon
cheat gear 3
cheat fuel 100
wait 20
cheat place 180 120
cheat vel 0 0
cheat face 1
cheat ent 1 194 120
press B 1
wait 2
expect fuel == 200
# the penny purse: 3 coins become 5
cheat gear 14
cheat no_foes
cheat coins 0
wait 20
cheat place 180 120
cheat vel 0 0
cheat face 1
cheat ent 1 194 120
press B 1
wait 2
cheat goto_kind 26
wait 2
expect coins == 5
# the seeker bells: one a slash, never more than two in the air
cheat gear 1
wait 20
cheat place 180 120
cheat vel 0 0
press B 1
wait 2
expect shotk4 == 1
wait 20
press B 1
wait 2
expect shotk4 == 2
wait 20
press B 1
wait 2
expect shotk4 == 2
# the bounce beam and the spit gun
cheat gear 2
cheat gear 4
wait 20
press B 1
wait 1
expect shotk5 >= 1
expect shotk6 == 1
