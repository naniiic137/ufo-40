# DOT & DASH: Dash ambles about on his own, very slowly; standing on him,
# UP stops him and UP again sets him off. Stand still beside him and he sits
# and looks up: UP then hears what he thinks. He can be lifted and thrown
# (it hurts, and he runs off with a yelp unless he wears his plate, coming
# back only when Dot is full size again or whistles), flies home and carries
# Dot up with Kite Wings, and has a world of his own in his fur: clear the
# fleas and his nose stops him over any spot of the room worth shrinking into.
game dotdash
wait 5
cheat newgame
cheat no_foes
wait 10
expect dash == 1
hold DOWN 95
waituntil trans == 0 60
expect scale == 1
expect dash == 1
# he wanders off by himself, slowly
cheat tile 20 82
cheat dash_at 180 657
wait 60
expect dash_x > 190
expect dash_x < 210
# stand on him and press UP: he stays; UP again and off he goes
cheat dash_at 180 657
cheat tile 23 81
wait 20
expect riding == 100
press UP 2
wait 5
expect dash_state == 6
wait 60
expect dash_x < 196
expect riding == 100
press UP 2
wait 30
expect dash_state == 0
# stand still beside him and he sits; UP and he talks
cheat tile 10 82
cheat dash_at 80 657
wait 60
expect dash_state == 8
press UP 2
wait 5
expect dialog == 1
cheat skip_dialog
wait 5
# lift him: stand on his back, B
cheat dash_at 172 657
cheat tile 22 81
wait 20
expect riding == 100
press B
wait 20
expect carry_kind == 1
# thrown at an ant: the ant is done for, and Dash yelps and runs off
cheat foe 0 210 658
hold RIGHT 1
wait 2
press B
wait 30
expect foes_0 == 0
expect dash == 0
expect dash_away == 1
# he doesn't come back by himself...
wait 700
expect dash == 0
# ...but the whistle brings him running
cheat give 18
cheat skip_dialog
press UP 2
press UP 2
wait 5
expect dash == 1
# with his plate he shrugs it off
cheat give 21
cheat skip_dialog
cheat tile 22 82
cheat dash_at 180 657
cheat tile 23 81
wait 20
press B
wait 20
expect carry_kind == 1
cheat foe 0 230 658
hold RIGHT 1
wait 2
press B
wait 30
expect foes_0 == 0
expect dash == 1
# kite wings: thrown, he flies out like a boomerang, biting everything on
# the way, and comes home unhurt
cheat give 22
cheat skip_dialog
wait 60
cheat tile 22 82
cheat dash_at 172 657
cheat tile 22 81
wait 20
expect riding == 100
press B
wait 20
expect carry_kind == 1
cheat foe 0 220 658
cheat foe 0 250 658
hold RIGHT 1
wait 2
press B
wait 90
expect foes_0 == 0
expect dash == 1
expect dash_state == 0
# and set on the thimble's roof, he walks straight off the edge and on
# through the air at the same height
cheat dash_at 104 617 1
wait 200
expect dash_y == 617
expect dash_x > 140
# his fur: stand on him and shrink, with the tonic
cheat give 2
cheat skip_dialog
cheat tile 22 82
wait 10
cheat dash_at 172 657
cheat tile 22 81
wait 20
expect riding == 100
hold DOWN 95
waituntil trans == 0 60
expect scale == 2
expect level_kind == 2
expect level_id == 0
expect foes_8 == 8
# the popgun at the way in, and eight fleas to shoot
cheat bot_tile 6 19
botuntil bot_state == 2 600
press B
wait 20
expect carry == 16
cheat bot_hunt 8
botuntil foes_8 == 0 6000
expect flag_5 == 1
cheat skip_dialog
# back outside, his nose works: set down on the rug he walks until he
# stands over a spot worth shrinking into, and points
hold UP 95
waituntil trans == 0 60
expect scale == 1
cheat tile 40 82
cheat dash_at 252 657 1
waituntil dash_state == 7 300
wait 2
expect sniff_x == 33
expect sniff_y == 83
# stand on him and UP: he goes on, and won't stop there again straight away
cheat tile 33 81
wait 20
expect riding == 100
press UP 2
wait 60
expect dash_state == 0
