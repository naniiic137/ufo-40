# DOT & DASH: small favours. Mrs. Humble the bee, poorly in the hive, wants
# honey caught in a jar (25). Half a face in the red book wants its other
# half, which wanders the blue books below (10). Wickless, sent away from
# Glimmer, sits on the portrait (15); Old Smut the exiled sporeling lives on
# the SIEGE box (20); a lumen lad on the shelf throws his glints over the
# edge, and they lie on the plant's top leaf. The living glint in the
# corner can be caught with the mitt (25). Archivist Tussock of Loamton
# takes a donation. A town Dot has found is marked in the room. The cell
# key can go to the tin knight instead (10).
game dotdash
wait 5
cheat newgame
cheat no_foes
cheat nodash
cheat god
cheat up tonic1
cheat up mitt1
cheat skip_dialog
# honey for the bee: a jar held under the drip in the comb
cheat micro 0 62 39 4
wait 5
expect town == 7
cheat bot_to npc:49
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.bee_done == 0
cheat obj 20
wait 2
cheat bot_to drip:1
botuntil bot_state == 2 3000
waituntil carry == 23 400
cheat bot_to npc:49
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.bee_done == 1
expect glints >= 25
expect carry == 20
hold DOWN B 3
wait 5
# the face: its right half in the blue books, lifted with the mitt
cheat grow
cheat micro 0 14 131 4
wait 5
expect foes_25 == 1
cheat above_foe 25
waituntil riding == 325 60
press B
wait 20
expect carry_kind == 3
cheat grow
cheat micro 0 17 137 4
wait 5
cheat bot_to npc:50
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.face_done == 1
# Wickless on the portrait
cheat grow
cheat micro 0 20 83 4
wait 5
cheat bot_to npc:51
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.exile_done == 1
# Old Smut on the SIEGE box
cheat grow
cheat micro 0 36 140 4
wait 5
cheat bot_to npc:53
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.exile2_done == 1
# the lumen lad on the shelf, and his glints on the plant's top leaf
cheat grow
cheat micro 0 30 56 4
wait 5
cheat bot_to npc:52
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect flag.dump_told == 1
cheat grow
cheat micro 0 30 52 4
wait 5
expect picks_1 >= 7
# the living glint in the corner by the door
cheat grow
cheat micro 0 84 6 4
wait 5
expect foes_26 == 1
cheat above_foe 26
waituntil riding == 326 60
press B
wait 30
expect flag.scamper == 1
expect foes_26 == 0
cheat skip_dialog
# the archivist
cheat grow
cheat micro 0 67 112 4
wait 5
cheat bot_to npc:54
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect asking == 1
press LEFT
press A
wait 5
expect flag.historian == 1
cheat skip_dialog
# Tuftville found: a pennant on its tile in the room
cheat grow
cheat micro 0 83 24 4
wait 5
expect town == 0
cheat grow
expect towns_seen & 1
# the cell key, given to the knight instead
cheat up bangle
cheat grow
cheat micro 0 69 27 4
wait 5
cheat bot_to obj:40
botuntil bot_state == 2 3000
press B
wait 20
expect carry == 40
cheat bot_tile 61 11
botuntil bot_state == 2 3000
press DOWN 2
wait 2
press DOWN 2
waituntil ground == 1 120
cheat bot_to npc:41
botuntil bot_state == 2 3000
press UP
wait 5
cheat bot_talk
botuntil bot_state == 2 900
expect asking == 1
press LEFT
press A
wait 5
expect flag.pell_guarded == 1
expect flag.pell_freed == 0
