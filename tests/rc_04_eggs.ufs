# ROOFCAT: defeating a foe scores nothing; it drops an egg (a fish token)
# and only picking that up scores. Spike lamps and firecrackers pay 200 on
# the spot instead.
game roofcat
wait 5
cheat area 0 1
cheat clear_foes
cheat cam 0
cheat put 60 83
wait 20
cheat foe snail 110 80
press B 1
wait 20
expect count_snail == 0
expect score == 0
expect tokens == 1
expect token_value == 100
hold RIGHT 30
expect score == 100
expect tokens == 0
# a spike lamp: ten stars, 200 on the spot, no egg
cheat clear_foes
cheat put 40 83
cheat foe lamp 120 82
hold B 200
expect count_lamp == 0
expect score == 300
expect tokens == 0
