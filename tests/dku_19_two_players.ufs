# DUKES UP: two players at once (our reading of the original's "2P co-op":
# no source says how it works). Each picks a fighter (the same one is
# allowed) and has a health bar and stats of their own; the purse is shared
# and the shop takes turns, player 1 then player 2; fists don't hurt your
# partner; the view only moves on when nobody is left behind. A partner who
# falls is out until the shop's $5 soup is bought for them, which brings
# them back at full health; only when both are down is it the continue
# screen.
game dukesup
wait 5
press DOWN
press A
wait 30
press A
expect state == 2
expect players == 2
wait 15
press RIGHT
press P2LEFT
expect sel1 == 1
expect sel2 == 3
press A
press P2A
expect state == 3
expect p1_pick == 1
expect p2_pick == 3
expect p2_throw == 3
expect p1_hp == 100
expect p2_hp == 100
wait 120
expect state == 4
# player 2 moves on the second pad
hold P2RIGHT 32
expect p2_x == 94
# a partner's fists don't hurt
cheat arena
cheat pos 1 120 140
cheat pos 2 100 140
cheat face 2 1
wait 2
press P2A 1
wait 12
expect p1_hp == 100
# the view waits for whoever is behind
cheat pos 1 300 140
cheat pos 2 20 140
hold RIGHT 60
expect cam <= 12
# player 1 falls: player 2 fights on; the night goes on
cheat hp 1 1
cheat hp 2 100
cheat pos 1 100 140
cheat spawn shambler 116 139
cheat foeface 2 -1
cheat foestrike 2
wait 80
expect p1_alive == 0
expect state == 4
# the shop: one purse, and turns at the counter
cheat clear
cheat cash 40
cheat nightdone
wait 70
press A
expect state == 6
expect shop_who == 0
press DOWN
press A
expect cash == 20
expect p1_power == 2
press UP
press UP
expect shop_sel == 4
press A
expect shop_who == 1
press P2DOWN
press P2DOWN
press P2DOWN
press P2A
expect p2_tough == 3
expect cash == 0
press P2DOWN
press P2A
expect state == 3
# no soup for the one who fell: still out on night 2
expect p1_hp == 0
expect p1_alive == 0
wait 120
expect p1_alive == 0
# night 2 done: this time the soup is bought for player 1, who is back at full health
cheat clear
cheat cash 10
cheat nightdone
wait 70
press A
expect shop_who == 0
press A
expect p1_hp == 100
expect cash == 5
press UP
press A
expect shop_who == 1
press P2UP
press P2A
expect state == 3
expect p1_alive == 1
expect p1_hp == 100
wait 120
# both down: the continue screen
cheat die
wait 80
expect state == 7
