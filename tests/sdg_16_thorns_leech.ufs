# SOUNDINGS: needlers prick whoever strikes them, unless the blow is a
# shield's. The leech club drinks back half of what it deals, but not on the
# blow that ends the fight.
game soundings
wait 30
press A
wait 20
cheat equip 0 0 1
cheat equip 1 0 16
cheat hp 2 0
cheat fight 1
waituntil bphase == 1 200
cheat foehp 0 30000
cheat seed 1
press A
press A
press A
press A
waituntil bround == 2 900
expect thorns_taken == 1
cheat bot_off
cheat hp 2 500
cheat equip 0 0 25
cheat hp 0 100
cheat fight 0
waituntil bphase == 1 200
cheat foehp 0 30000
press A
press A
press DOWN
press DOWN
press A
press DOWN
press DOWN
press A
waituntil bround == 2 900
expect leech_healed > 100
