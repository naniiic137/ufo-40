# HAT TRICK: running, the one fixed jump (a tap and a long press go just as
# high: 38 px from the floor, enough for the next ledge up, 32 px), the
# stiff air control (from a standing jump the pad barely bends the arc), and
# the big kid (12 x 19). Ledges let you jump up through them.
game hattrick
wait 5
cheat level 1
cheat skipintro
cheat still
cheat god
cheat pos 0 100 160
wait 2
expect p0_ground == 1
hold RIGHT 30
expect p0_vx100 == 125
expect p0_x > 130
# a tap
cheat pos 0 100 160
wait 3
hold A 1
expect p0_ground == 0
waituntil p0_vy100 >= 0 60
expect p0_y10 == 1220
waituntil p0_ground == 1 60
expect p0_y == 160
# held: the same height
wait 3
hold A 15
waituntil p0_vy100 >= 0 60
expect p0_y10 == 1220
waituntil p0_ground == 1 60
# no jumping again while A stays down
wait 3
hold A
wait 70
expect p0_ground == 1
expect p0_y == 160
release A
# a standing jump, then RIGHT in the air: it hardly moves across
wait 3
press A 1
hold RIGHT 20
expect p0_vx100 <= 60
expect p0_x < 108
waituntil p0_ground == 1 60
# a running jump up onto the ledge above (its top is 32 px up): through it from below
cheat pos 0 100 160
wait 2
hold LEFT 8
hold LEFT A 2
hold LEFT
wait 5
waituntil p0_ground == 1 60
release
expect p0_ground == 1
expect p0_y == 128
