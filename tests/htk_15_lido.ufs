# HAT TRICK, world 3 (the Lido): buoys slide straight down through ledges
# and out of the bottom, in at the top (or along, through the sides); polo
# players swim their ledge and squirt at a kid, level or down; duckies
# paddle round and round the ledge they sit on: along the top, round the
# end, back underneath.
game hattrick
wait 5
cheat level 21
cheat skipintro
cheat god
cheat nofoes
cheat foe 6 60 20 1
cheat foe 1 300 20 1
waituntil fy_6 > 150 300
waituntil fy_6 < 20 100
expect fx_6 == 60
# a buoy along
cheat nofoes
cheat foealt 6 280 140 1
cheat foe 1 300 20 1
waituntil fx_6 < 20 100
expect fy_6 == 140
# a polo player squirts, never upwards
cheat nofoes
cheat foe 7 100 88 1
cheat foe 1 300 20 1
cheat pos 0 100 40
waituntil shots_2 == 1 600
expect shot0_vy100 >= 25
# a ducky: round its ledge, above it and below it in turn
cheat noshots
cheat nofoes
cheat foe 8 120 88 1
cheat foe 1 300 20 1
waituntil fy_8 > 100 400
waituntil fy_8 < 96 400
expect fx_8 >= 82
expect fx_8 <= 238
