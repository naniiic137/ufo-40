# BRAVADO: RAISE PRIZE puts the next prize up by 100 and adds one random
# pack to the next fight, shown only once it's added. It stops at 16 packs
# and 1,600. Mites and gasbags come nine to a pack; the others vary. A
# pack of slag pours three more pools at the start of the fight.
game bravado
wait 5
cheat run 1
cheat round 2
expect prize == 100
expect groups == 1
expect shop_btn == 1
press A
expect prize == 200
expect groups == 2
press A
press A
press A
press A
press A
press A
press A
press A
press A
press A
press A
press A
press A
press A
expect prize == 1600
expect groups == 16
expect bad_groups == 0
press A
expect prize == 1600
expect groups == 16
# the lineup's monsters, as the window shows them
expect lineup_monsters >= 2
# slag: three more pools each
cheat nolineup
cheat group 6 3
cheat group 6 3
cheat group 0 9
cheat fight
expect pools == 9
expect queue == 9
