# FLINTHOLD: clearing the last stage is the Saucer; clearing every stage
# without the cave taking a hit is the Alien, and it brings the better
# ending. The save keeps every stage's result, the villages found and the
# four numbers; the goals come back from it.
game flinthold
wait 5
cheat clear 1 3
cheat clear 2 3
cheat clear 3 3
cheat clear 4 3
cheat clear 5 3
cheat clear 6 3
cheat clear 7 3
cheat clear 8 3
cheat clear 9 3
expect perfects == 9
expect goals !& 2
cheat stage 10
cheat win
wait 60
expect state == 4
expect res_perfect == 1
expect done10 == 3
expect perfects == 10
expect goals & 2
expect goals & 4
expect good_end == 1
wait 70
press A
wait 2
expect state == 6
wait 490
press A
wait 2
expect state == 2
reload
game flinthold
wait 5
expect done10 == 3
expect best10 == 30
expect won == 1
expect perfects == 10
expect goals & 6
