# SHUTTERBUG: something odd in the scenery, photographed, shakes out five
# score orbs; shot, they pay 20, 40, 60 ... (up to 200), more for each orb
# shot in the same life (the count carries on into the next stage, and
# starts again only after a lost ship). Each counts as a secret photo.
game shutterbug
cheat run 1
cheat quiet
cheat stop
cheat clear
cheat pos 60 84
cheat dummy 25 167 84 0
press A
expect secrets == 1
expect foes_27 == 5
hold B
waituntil orbs_shot >= 1 120
expect score == 20
# the next one floated down and back: go after it
hold B DOWN 16
hold B
waituntil orbs_shot >= 2 120
expect score == 60
release B
expect orbs_shot == 2
cheat stage 1
cheat quiet
expect orbs_shot == 2
cheat lives 1
cheat hurt 0
wait 101
cheat hurt 0
wait 160
expect state == 4
wait 200
expect orbs_shot == 0
cheat stage 0
cheat quiet
cheat stop
cheat clear
cheat pos 60 84
cheat dummy 25 167 84 0
cheat flash 1320
press A
expect secrets == 2
# a second photo of the same thing does nothing more
wait 1320
press A
expect secrets == 2
