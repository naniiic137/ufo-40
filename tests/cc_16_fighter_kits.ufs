# CUTLASS CUP: every fighter's secondary weapon and Super Shot.
game cutlass
wait 5
# Leila: a sea urchin, Wall Runner
cheat match 1 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 100
cheat meter 0 4
press B 1
press B 1
expect projs2 == 1
wait 20
hold B
wait 34
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 2
# Nour: a harpoon line, Mirage fakes
cheat match 2 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 100
cheat meter 0 4
press B 1
press B 1
expect projs3 == 1
wait 60
hold B
wait 34
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 3
expect fakes >= 2
# Karim: the sirocco flurry, Whirl
cheat match 3 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 100
cheat meter 0 4
press B 1
press B 1
expect projs4 == 1
wait 20
hold B
wait 34
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 4
# Zina: a dart; she blinks and leaves a decoy; Djinn
cheat match 4 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 100
cheat meter 0 4
press B 1
press B 1
expect projs5 == 1
wait 20
press A
expect projs7 == 1
expect px0 > 100
cheat pos 0 60 100
hold B
wait 34
cheat ball 70 100 0 0
release B
wait 8
expect ball_kind == 5
# Omar: a powder pot, the trident thrust, Plunge
cheat match 5 0
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 60 60
cheat meter 0 4
press B 1
press B 1
expect projs6 == 1
wait 30
hold DOWN A 2
expect st0 == 2
wait 20
hold B
wait 34
cheat ball 70 60 0 0
release B
wait 8
expect ball_kind == 6
