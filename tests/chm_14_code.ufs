press UP
press RIGHT
press UP
press UP
press UP
press UP
expect code_pos == 7
expect fast_loot == 0
press A
expect fast_loot == 1
expect state == 1
# a wrong code does nothing
press UP
press A
expect fast_loot == 1
expect state == 1
press DOWN
# back to the title, and a tournament with the code on
press B
wait 10
expect state == 0
press UP
press UP
wait 5
press A
wait 15
press A
wait 5
expect state == 4
wait 25
press A
wait 5
expect st_t0 <= 105
expect st_t1 <= 105
cheat finish 0 1 2 3 4 5
wait 5
expect goals == 0
expect race_wins == 0
expect race_n1 == 0
# L A S T - L A M P from there: the page
reload
