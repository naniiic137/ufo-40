# SKID KIDS: B held with a bag winds up; the kid can't move then, the pad
# aims instead (eight ways, the last way pressed sticks), and letting go
# throws that way. A full wind-up knocks the kid it hits flat, and every
# hit is a point.
game skidkids
wait 5
cheat match 0 5 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 100 150
cheat kid 1 40 60
cheat kid 2 180 70
cheat kid 3 250 170
cheat give 0 1
hold B
wait 15
expect kst0 == 2
hold DOWN
wait 20
expect kx0 == 100
expect ky0 == 150
expect aimy0 == 1
release DOWN
hold UP RIGHT
wait 30
expect kx0 == 100
expect aimx0 == 1
expect aimy0 == -1
release UP RIGHT
wait 5
release B
wait 2
expect n_throw == 1
expect held0 == 0
expect sliding == 1
# up and right, forty-five degrees, at the kid up the court
waituntil score0 == 1 60
expect kst2 == 5
expect n_down == 1
