# RESTLESS: the demo player, pressing real buttons from the title, plays
# the whole game: the soul rounds, all three stages in both halves, the
# pits, and the six fights, and lays the Hollow King to rest.
seed 3
game restless
wait 10
botuntil half >= 1 30000
expect boss_kind == 2
botuntil half >= 2 30000
botuntil half >= 3 30000
botuntil half >= 4 30000
botuntil half >= 5 30000
expect boss_kind == 6
botuntil state == 9 40000
expect won == 1
expect goals & 2
expect goals & 1
expect save_wins == 1
