# BANNERFALL: taking the last enemy banner wins the battle and opens the
# next one; losing your last banner loses; both at once is a draw.
game bannerfall
wait 5
cheat battle 1
cheat clear
cheat flags 2 1
cheat unit 7 2 1 0
cheat endturn
wait 200
expect state == 4
expect won == 1
expect beaten & 1
expect goals == 0
# defeat
cheat battle 2
cheat clear
cheat flags 1 3
cheat unit 0 2 1 1
cheat endturn
wait 200
expect state == 4
expect losses == 1
expect won == 1
# draw
cheat battle 2
cheat clear
cheat flags 1 1
cheat unit 7 2 1 0
cheat unit 0 3 1 1
cheat endturn
wait 200
expect status == 3
expect won == 1
expect losses == 1
