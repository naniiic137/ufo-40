# VESPER: troopers pop up from behind cover at three depths; a shot hits
# the nearest thing under the sight. Each kill feeds the combo meter; it
# multiplies the points (x1, then one more for every three kills in a row)
# and runs down if she stops scoring.
seed 1
game echounit
wait 5
cheat mission 1
cheat gnospawn
cheat gclear
cheat god
wait 10
cheat score 0
cheat gfoe 1 2 160
cheat gfoestill 0
cheat gaim 160 128
press A 1
wait 10
expect g_kills == 1
expect g_combo == 1
expect score == 10
cheat gfoe 1 2 160
cheat gfoestill 0
cheat gaim 160 128
press A 1
wait 10
cheat gfoe 1 2 160
cheat gfoestill 0
cheat gaim 160 128
press A 1
wait 10
expect g_combo == 3
# the third kill in a row is worth double
expect score == 40
wait 160
expect g_combo == 0
# a shot that hits nothing does nothing
cheat gaim 160 60
press A 1
expect g_kills == 3
