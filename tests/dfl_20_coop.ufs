# DRIFTLINE: 2 PLAYERS is one car with a driver and a gunner. Player 1's
# pad drives it (and so does the power drift and fills the one meter);
# player 2's pad swings the gun (LEFT/RIGHT, UP back to straight up) and
# fires it: B the main gun, A the side guns, which point the way player 2
# holds. The driver's steering leaves the gun alone, and the driver's
# buttons don't fire. One stock of cars; in the bonus stage the one car is
# the paddle and the gunner shoots blocks.
game driftline
wait 12
press DOWN
press A
expect players == 2
expect on0 == 1
expect alive0 == 1
expect spare == 3
cheat nospawn
wait 10
cheat pos 100
expect aim0 == 0
# player 1 drives; the gun stays put
hold RIGHT 20
expect x0 > 100
expect aim0 == 0
# player 2 swings the gun; the car stays put
wait 30
cheat pos 160
hold P2RIGHT 10
expect aim0 == 20
expect x0 == 160
hold P2UP 10
expect aim0 == 0
hold P2LEFT 5
expect aim0 == -10
expect x0 == 160
# the driver's drift fills the meter
cheat meter 0
hold LEFT 30
expect meter0 > 200
wait 30
# only the gunner fires
press B
press A
expect fired0 == 0
expect pairs0 == 0
press P2B
expect fired0 == 1
press P2LEFT P2A
expect pairs0 == 1
expect side_left == 2
wait 60
# one stock of cars, and a new car comes in charged
cheat kill
waituntil alive0 == 1 120
expect spare == 2
expect meter0 == 720
# the bonus stage: the car is the paddle, the gunner breaks the last block
wait 60
cheat bonus
expect alive0 == 1
cheat ball 160 120 0 2.5
waituntil ball_vy10 < 0 120
cheat blocks 1
cheat meter 700
cheat pos 124
hold P2UP 20
hold P2B
waituntil blocks_left == 0 60
release
waituntil coins == 1 200
expect spare == 4
waituntil state == 1 500
expect stage == 2
# out of cars: the end
cheat spare 0
cheat kill
waituntil state == 5 200
