# ROOFCAT: like Ninpek, nothing is kept mid-run: the title only starts a new
# run from the first rooftop. Scores go on a board of five, best first, with
# the most foes defeated and letters found. A save from the first version
# (which held a checkpoint) keeps its best score and nothing else.
game roofcat
wait 20
cheat old_save
expect hi0 == 12345
expect state == 0
press A
wait 75
expect state == 2
expect area == 0
expect loop == 1
expect lives == 3
expect score == 0
cheat clear_foes
cheat put 40 83
cheat foe snail 110 80
press B 1
wait 20
expect kills == 1
cheat score 20000
cheat lives 0
cheat kill
waituntil state == 3 200
wait 65
expect hi0 == 20000
expect hi1 == 12345
expect new_rank == 0
expect most_foes == 1
expect most_letters == 0
# back to the title, and a new run from the start
press A
wait 20
expect state == 0
press A
wait 75
expect state == 2
expect score == 0
expect lives == 3
# a run left in the middle (quitting to the library) still counts
cheat score 500
reload
expect save.roofcat == 28
game roofcat
wait 5
expect state == 0
expect hi0 == 20000
expect hi1 == 12345
expect hi2 == 500
expect hi4 == 0
