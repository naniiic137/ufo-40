# SKID KIDS: KIKI (Yoka's kit). She carries two bags (a tap by a second bag
# picks it up instead of passing), and throws them one after the other; her
# special throw is the YO-YO; her move is the GUST.
game skidkids
wait 5
cheat match 6 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 1
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 100 100
cheat give 0 1
cheat loose 106 100
press B
wait 16
expect held0 == 2
expect n_pass == 0
cheat kid 2 200 100
hold B 70
wait 2
expect held0 == 1
waituntil score0 == 1 60
hold B 30
wait 30
expect n_throw == 2
expect held0 == 0
# the yo-yo
waituntil kst2 == 0 100
cheat clearbags
cheat stars 0 2
cheat give 0 1
hold B 70
wait 2
expect bagkind0 == 2
waituntil score0 == 3 150
# the gust
waituntil kst2 == 0 100
cheat clearbags
cheat loose 130 100
cheat stars 0 2
press A
wait 4
press A
expect gust > 0
waituntil score0 == 4 150
