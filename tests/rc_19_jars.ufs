# ROOFCAT: jumping jars hop toward her; left alone for sixteen hops a jar
# turns into a crown worth 300. A jar dives when she is right underneath and
# falls away through everything (keep running and it misses). No more than
# four are awake at once, and while she is a spirit they hop away left.
game roofcat
wait 5
cheat area 0 1
cheat clear_foes
cheat cam 0
cheat put 20 83
wait 5
cheat foe jar 250 80
cheat hops 15
wait 100
expect count_jar == 0
expect crowns == 1
# the dive: a jar over the ledge of screen 5 with Pepper right underneath;
# she runs on and it misses
cheat cam 1600
cheat clear_foes
cheat put 140 83
cheat foe jar 140 36
wait 1
expect mode_jar == 7
hold RIGHT 20
wait 60
expect count_jar == 0
expect spirit == 0
# at most four awake
cheat clear_foes
cheat dormant jar 200 80
cheat dormant jar 220 80
cheat dormant jar 240 80
cheat dormant jar 260 80
cheat dormant jar 280 80
wait 2
expect count_jar == 4
expect all_jar == 5
# a spirit: they hop off to the left, away from her
cheat cam 1600
cheat clear_foes
cheat put 280 83
cheat foe jar 100 80
cheat kill
expect spirit == 1
expect wx_jar == 1703
wait 150
expect wx_jar < 1680
