# PETAL PARADE: B on a sun circle saves the whole line; each pup scores
# 10 x its place in the line (3 pups: 10+20+30), and the circle moves.
game petalparade
wait 5
press A
cheat clear
cheat put pup 5 7
cheat put pup 5 6
cheat put pup 5 5
cheat put pad 5 4
expect pads == 1
wait 34
expect line == 2
wait 6
expect hy == 4
expect line == 3
press B
expect line == 0
expect saved == 3
expect score == 60
expect counter == 3
expect pads == 1
expect state == 1
