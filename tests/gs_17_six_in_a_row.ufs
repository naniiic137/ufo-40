# GRUB SHIFT: six contracts in a row earns the Alien; a failed contract
# resets the run to contract 1.
game grubshift
wait 5
cheat contract 6 7
cheat clear
cheat kills 29
cheat bug 3 2 1 0
cheat use 5 3 2
wait 150
expect streak == 6
expect goals & 4
press A
wait 10
cheat clear
cheat bug 0 0 1 3
cheat rest
wait 150
expect status == 3
expect streak == 0
press A
wait 10
expect state == 0
press A
wait 10
expect contract == 1
