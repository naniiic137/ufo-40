# FORLORN HOPE: a floor plate is down only while something weighs on it;
# while it is down, its blocks stand somewhere else on the map. A stone
# holds it down for good. The first plate pressed earns the Beacon.
game forlorn
cheat start 1
wait 20
cheat no_foes
expect goals == 0
expect solid50050 == 0
cheat class 0
wait 2
cheat place 575 365
wait 3
expect plate0 == 1
expect solid50050 == 1
expect solid50058 == 1
expect switches == 1
expect goals & 1
expect plate_ever == 1
hold LEFT 20
expect plate0 == 0
expect solid50050 == 0
# a mason's stone on it
cheat place 575 365
wait 3
expect switches == 2
cheat give_up
wait 2
expect tile36057 == 9
wait 110
expect plate0 == 1
expect solid50050 == 1
expect switches == 2
