# CHIME CIRCUIT: a lap counts at the start line only after every
# checkpoint round the track, in order; each finished lap mends one hit
# point (never above three). Eight laps finish the race.
seed 1
game chime
wait 30
cheat race 1
cheat park_cpus
cheat go
expect ncp == 3
# straight over the line with no checkpoints: nothing
cheat place 0 70 140
cheat vel 0 300 -250
wait 20
expect x0 > 88
expect laps0 == 0
expect cp0 == 1
# with all three passed, the line counts
cheat cp 0 4
cheat hp 0 1
cheat place 0 70 140
cheat vel 0 300 -250
wait 20
expect laps0 == 1
expect cp0 == 1
expect hp0 == 2
expect hpshow0 > 30
expect lastlap0 > 0
# the next lap mends another
cheat cp 0 4
cheat place 0 70 140
cheat vel 0 300 -250
wait 20
expect laps0 == 2
expect hp0 == 3
# at full health a lap mends nothing
cheat hp 0 3
cheat cp 0 4
cheat place 0 70 140
cheat vel 0 300 -250
wait 20
expect laps0 == 3
expect hp0 == 3
# a real lap flown with button presses passes the checkpoints in order
botuntil cp0 == 2 1000
botuntil cp0 == 3 1000
botuntil cp0 == 4 1000
botuntil laps0 == 4 1000
# the eighth lap finishes the race
cheat laps 0 7
botuntil fin0 == 1 2000
expect place0 == 1
expect laps0 == 8
