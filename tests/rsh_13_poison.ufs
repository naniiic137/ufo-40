# RIMSHIRE: the adder does no damage but poisons; a poisoned disk dies to
# the next damage of any size. With a star (+1) its first bite kills at once:
# the poison lands before the damage is counted.
game rimshire
cheat war 1
cheat cpu 1 -1
cheat army 0 AS
cheat army 1 SS
cheat battle 6 1 0
cheat field 0
cheat place 0 100 128
cheat place 1 100 40
cheat place 2 150 128
cheat place 3 300 220
waituntil bphase == 1 200
press A
expect sel == 0
hold RIGHT 40
hold A 12
wait 1
waituntil bphase == 2 400
expect d2_poison == 1
expect d2_hp == 4
# the adder's second move, away
hold UP 70
hold A 12
wait 1
waituntil bside == 1 600
# Plum: the far squire takes a small step away
waituntil bphase == 1 60
press RIGHT
press A
expect sel == 3
hold DOWN 70
hold A 12
wait 1
waituntil bphase == 2 400
hold A 12
wait 1
waituntil bside == 0 600
# Brass: the squire's one-damage knock kills the poisoned disk
waituntil bphase == 1 60
press A
expect sel == 1
cheat place 1 150 60
cheat place 2 150 128
hold DOWN 70
hold A 36
wait 1
waituntil moving == 0 600
expect d2_on == 0
