# TIN TROOP 2-B: the scales.
game tintroop
wait 5
cheat level 4
cheat no_foes
wait 120
# the counterweight: a soldier on the near pan sinks it and lifts the far pan
cheat pos 90 121
wait 50
expect pan_off == 20
# a stone keeps it down after he's gone
press DOWN+B
wait 60
expect pan_off == 20
# the next soldier hops across on the far pan before it sinks back
cheat pos 134 121
wait 2
hold RIGHT+A 20
hold RIGHT 12
expect px > 155
expect py < 125
hold RIGHT+A 20
hold RIGHT 10
expect mode == 3
expect px > 195
expect py == 121
# the lift: his own weight takes the pan down to the tunnel
cheat pos 366 121
wait 50
expect py == 141
hold RIGHT 100
expect px > 470
hold RIGHT+A 20
wait 40
hold RIGHT+A 20
hold RIGHT 20
expect mode == 3
expect py == 121
expect px > 510
# the gate: a stone on the switch
cheat pos 702 121
wait 3
press DOWN+B
wait 40
expect gate0 == 1
cheat pos 720 121
hold RIGHT 80
expect px > 800
cheat pos 1380 121
hold RIGHT 80
expect state == 4
