# HOMESPUN: the Volthog, a mechanical boar of bolts and bombs, guards the
# ruins and bars the only way to Mother Loom's lair; it is back on every
# trip. Beating Mother Loom earns the Beacon at once: she moves to camp and
# spins a spool of thread every 30 seconds.
seed 44
game homespun
wait 5
cheat newgame 115
wait 5
cheat trip 5
cheat goruins
wait 2
expect boss == 22
expect gate_shut == 1
cheat bosshp 1
cheat holdmobs
cheat face 0 -1
cheat at 160 110
wait 1
press B
wait 25
expect boss == -1
expect volt_down == 1
expect gate_shut == 0
cheat golair
wait 2
expect boss == 23
expect goals !& 1
cheat bosshp 1
cheat holdmobs
cheat at 160 110
press B
wait 25
expect loom == 1
expect goals & 1
# the Volthog is back next trip, the lair stays empty
cheat room 43 160 150
hold DOWN 20
wait 50
press A
cheat trip 5
cheat goruins
wait 2
expect boss == 22
expect gate_shut == 1
cheat golair
wait 2
expect boss == -1
# thread at camp
cheat room 43 160 150
hold DOWN 20
wait 50
press A
cheat res thread 0
idle 2
expect thread == 4
