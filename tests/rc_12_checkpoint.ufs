# ROOFCAT: reaching an area saves a checkpoint; CONTINUE resumes from it
# after quitting.
game roofcat
wait 5
cheat area 0 1
cheat clear_foes
cheat cam 3700
wait 5
expect cp_area == 1
cheat lives 5
cheat area 2 1
expect has_checkpoint == 1
reload
game roofcat
wait 10
press A
wait 5
expect area == 2
expect lives == 5
