# UNDERDELVE: ropes can only be gripped with the Climbing Gloves; with them Mo
# climbs down the Rope Drop into the Key Vault, where the Brass Key waits.
game underdelve
wait 10
press A
wait 5
cheat room 5 3 102 66
cheat clear_enemies
cheat no_gloom
wait 10
expect grounded == 1
# without gloves the rope is just decoration: Mo falls onto the spikes
hold RIGHT+A 4
hold UP 60
expect deaths == 1
wait 100
cheat lanterns 6
cheat give 8
cheat room 5 3 102 66
cheat clear_enemies
cheat no_gloom
wait 10
hold RIGHT+A 4
hold UP 50
expect climbing == 1
hold DOWN 150
expect room_y == 4
expect deaths == 1
