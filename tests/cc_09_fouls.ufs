# CUTLASS CUP fouls: dawdling (the ball stays on your side too long) and
# striking the other player with your blade (which stuns them); a third
# foul ends the point and gives the other side a penalty point.
game cutlass
wait 5
cheat match 0 1
cheat cpu 1 0
wait 2
cheat play
cheat pos 0 30 60
cheat ball 100 150 0 0
wait 310
expect fouls_l == 1
# a blade foul
cheat play
cheat pos 0 150 100
cheat pos 1 162 100
press B
wait 10
expect fouls_l == 2
expect st1 == 4
# the third one: a penalty point
cheat play
cheat pos 0 30 60
cheat ball 100 150 0 0
wait 310
expect score_r == 1
expect fouls_l == 0
