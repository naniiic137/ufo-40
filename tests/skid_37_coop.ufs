# SKID KIDS: 2P CO-OP. Two players on one team, one kid each, through the
# same tournament: player 1 picks first in the draft, player 2 picks the
# last. Nobody swaps kids, each jumps on their own, and the goals count.
seed 18
game skidkids
wait 20
press DOWN
press A
wait 10
expect mode == 1
expect versus == 1
press A
wait 12
press A
expect phase == 1
wait 90
expect phase == 2
press P2A
expect phase == 3
wait 50
press A
wait 5
expect bracket_ok == 1
botuntil state == 7 800
cheat coach 0
cheat play
cheat freeze 2
cheat freeze 3
cheat clearbags
cheat kid 0 60 80
cheat kid 1 60 140
hold P2RIGHT 20
expect kx1 == 80
expect kx0 == 60
hold RIGHT 20
expect kx0 == 80
press B
expect ctrl0 == 0
expect n_swap == 0
press P2A
expect kz1 > 0
expect kz0 == 0
wait 40
cheat win 0
wait 160
botuntil state == 7 800
cheat win 0
wait 160
botuntil state == 7 800
cheat win 0
wait 160
expect goals == 1
