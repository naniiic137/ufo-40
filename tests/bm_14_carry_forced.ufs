# BOOMTOWN: fireworks left on the square stay there for the next night, and
# the ones not used stay in the cart. With none left in the cart the cursor
# sits on LIGHT; with nothing anywhere the night ends by itself.
seed 24
game boomtown
wait 20
press A
wait 15
press A
wait 100
cheat clear
cheat put folk 0 0
cheat put folk 0 1
cheat put bogle 9 7 0
cheat put piece 8 7 1
# one set down by hand, far from anything
cheat sel 0
cheat cursor 2 5
press A
press A
expect hand == 14
expect occ_2_5 == 4
press RIGHT
press RIGHT
press RIGHT
press A
cheat cursor 8 7
press A
waituntil state == 8 300
expect result == 1
press A
waituntil state == 2 200
expect occ_2_5 == 4
expect hand == 29
waituntil state == 3 200
# nothing in the cart: LIGHT it is
cheat clear
cheat put folk 0 0
cheat put piece 5 5 1
cheat row 0 0 0
cheat hand 0
cheat pick
expect sel == 3
press LEFT
expect sel == 3
press A
expect state == 6
press B
expect state == 3
# nothing anywhere: the night ends by itself
cheat put empty 5 5
wait 30
expect state == 8
expect result == 1
