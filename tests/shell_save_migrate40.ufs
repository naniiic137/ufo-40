# SHELL: a progress file from the days of 40 slots still loads after the
# library grew to 50. Goals and play counts for slots 01-40 carry over, the
# settings stay, the new slots 41-50 start empty, and the file is written
# back in the 50-slot layout (with the NEW tags' bits: like any save from
# before them, only the latest batch of cartridges is NEW).
legacy_progress 4 6 14 1 1 3 7 5 3 28 2 40 4
reload
expect goals.underdelve == 1
expect goals.roofcat == 7
expect goals.petalparade == 3
expect goals.dune == 2
expect goals.grubshift == 0
expect played.underdelve == 1
expect played.dune == 1
expect played.grubshift == 0
expect music_vol == 4
expect sfx_vol == 6
expect library_cursor == 14
expect total_goals == 8
expect new.chime == 1
expect new.buzzbolt == 1
expect new.underdelve == 0
expect new.dune == 0
expect new.wobble == 0
# nothing played on the clock yet, every button as made
expect play_secs.underdelve == 0
expect last_played.underdelve == 0
expect remap.underdelve == 123
progress_bytes 592
# a second start reads the upgraded file the same way
reload
expect goals.roofcat == 7
expect goals.dune == 2
expect music_vol == 4
expect total_goals == 8
# the new slots take goals like any other (slot 41-50 have no cartridge yet,
# so award through a loaded one and check the count only grows by it)
set_goals fennec 1
reload
expect total_goals == 9
