# WOBBLE DERBY: the stables offer three wobblers that may run in a future
# race, never one of this race's runners, and a runner can't be sponsored
# even by other means; a wobbler sponsored now pays from the next race on.
game wobble
wait 5
cheat new 6 1
cheat cash 1 0
cheat cash 2 0
expect offer_ok == 1
cheat field 6 15 17
expect offer_ok == 1
# this race's runners can't be sponsored, even when put on the list
cheat try_sponsor 0 6
cheat try_sponsor 0 15
cheat try_sponsor 0 17
expect sponsor6 == 0
expect sponsor15 == 0
expect sponsor17 == 0
cheat offer 6 15 17
cheat try_sponsor 0 6
expect sponsor6 == 0
expect cash0 == 1000
cheat field 6 15 17
# nor anything off the list
cheat offer 0 1 2
cheat try_sponsor 0 9
expect sponsor9 == 0
# the list with the buttons: the second one on offer
wait 25
press A
press DOWN
press DOWN
press DOWN
press DOWN
press A
expect sub == 8
press DOWN
press A
expect sponsor1 == 1
expect sponsored0 == 1
press B
# every race deals a fresh three, and none of them is running
cheat autorace
expect offer_ok == 1
cheat autorace
expect offer_ok == 1
cheat autorace
expect offer_ok == 1
