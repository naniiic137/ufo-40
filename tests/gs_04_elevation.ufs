# GRUB SHIFT: shots can't go uphill, but a lob ignores height;
# rolling down off a planter onto a grub stomps it.
game grubshift
wait 5
cheat contract 1 7
cheat clear
cheat elev 3 2 1
cheat bug 3 2 1 0
cheat use 5 3 2
expect spent == 0
expect kills == 0
cheat use 6 3 2
expect kills == 1
cheat elev 2 2 1
cheat bug 1 2 1 0
cheat use 0 1 2
expect kills == 2
expect px == 1
