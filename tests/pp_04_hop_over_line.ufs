# PETAL PARADE: A hops over the next tile - here Lina's own line.
game petalparade
wait 5
press A
cheat clear
cheat put pup 5 7
cheat put pup 5 6
cheat put pup 5 5
cheat put pup 5 4
wait 44
cheat turn 0
wait 8
cheat turn 1
wait 8
cheat turn 2
press A
wait 20
expect state == 1
expect hx == 3
expect line == 4
