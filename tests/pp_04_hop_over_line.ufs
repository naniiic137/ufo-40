# PETAL PARADE: A hops at once and clears exactly one tile - here Posy's
# own line. The line follows her path over it.
game petalparade
wait 20
press A
cheat clear
cheat put pup 5 7
cheat put pup 5 6
cheat put pup 5 5
cheat put pup 5 4
wait 44
press RIGHT
press DOWN
wait 5
press LEFT
wait 3
press A
expect air > 0
wait 16
expect state == 1
expect hx == 3
expect hy == 5
expect line == 4
