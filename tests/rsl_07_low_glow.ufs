# RESTLESS: every death sends his wisp into the Low Glow: 1, 3, 6, 9, then
# 12 soul pieces, each with a guardian; from four deaths blue flames bounce
# about too. The wisp flies eight ways; each piece taken keeps it safe a
# moment; a guardian's touch is the end of the run.
game restless
wait 5
cheat half 0
cheat nospawn
cheat notimer
cheat deaths 1
cheat die
waituntil state == 4 200
expect deaths == 2
expect pieces == 3
expect guards == 3
expect flames == 0
cheat winspirit
waituntil state == 2 200
cheat die
waituntil state == 4 200
expect pieces == 6
expect flames == 0
cheat winspirit
waituntil state == 2 200
cheat die
waituntil state == 4 200
expect deaths == 4
expect pieces == 9
expect guards == 11
expect flames == 2
cheat winspirit
waituntil state == 2 200
cheat die
waituntil state == 4 200
expect pieces == 12
expect flames == 3
cheat winspirit
waituntil state == 2 200
cheat deaths 8
cheat die
waituntil state == 4 200
expect pieces == 12
expect flames == 4
# the wisp: still for half a second, then eight ways at 1.5 px a frame
expect wisp_x == 160
wait 40
hold RIGHT 10
expect wisp_x == 175
hold LEFT UP 8
expect wisp_x == 166
expect wisp_y == 91
# a piece taken: safe for 40 frames
cheat piece 0 166 91
wait 1
expect pieces_got == 1
expect spirit_inv == 40
cheat winspirit
waituntil state == 2 200
# a guardian's touch ends it all
cheat deaths 0
cheat die
waituntil state == 4 200
wait 70
cheat guard 0 160 100
wait 2
expect spirit_failed == 1
waituntil state == 7 200
expect state == 7
