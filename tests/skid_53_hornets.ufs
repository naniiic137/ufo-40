# SKID KIDS: the HORN-ETS! code (hinted by the gym's banner, STING 'EM,
# HORNETS!): 2P co-op as the kangaroo and the robot. The final is still
# against the robot.
seed 32
game skidkids
wait 20
cheat code HORNETS!
expect codes == 4
press DOWN
press A
wait 5
expect mode == 1
expect teama0 == 12
expect teama1 == 13
expect opp5_1 == 13
expect bracket_ok == 1
expect state == 4
