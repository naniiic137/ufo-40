# WITHERLEA: the big bedroom door, swollen in its frame, opens two ways:
# levered with the poker, or lifted off its hinges with the screwdriver. And
# the mixture can't be made until Tom's tape has said what goes in it:
# blue crystals, quicklime and water, in the rose sprayer.
game witherlea
wait 5
cheat new
cheat spawn 99999
cheat set F_STAIRS_LIT
cheat room landing
cheat aim S_LAN_MASTER_SHUT
press A
expect flag_F_MASTER_OPEN == 0
cheat hush
cheat hold poker
press A
expect flag_F_MASTER_OPEN == 1
expect noises == 0
cheat hush
cheat unset F_MASTER_OPEN
cheat hold screwdriver
cheat aim S_LAN_MASTER_SHUT
press A
expect flag_F_MASTER_OPEN == 1
cheat hush
# the tape: power, the empty spool and the tape itself
cheat new
cheat spawn 99999
cheat set F_STAIRS_LIT
cheat room study
cheat give reel
cheat give tape
cheat aim S_STU_RECORDER
cheat hold reel
press A
cheat hush
cheat hold tape
press A
cheat hush
press A
expect flag_F_RECIPE == 0
cheat hush
cheat set F_POWER
press A
expect flag_F_RECIPE == 1
cheat hush
# the mixture
cheat new
cheat spawn 99999
cheat give sprayer
cheat give sulphate
cheat give lime
cheat give water
expect slotof_sprayer == 0
cheat hold sprayer
press B
press RIGHT
press A
expect mix == 0
expect has_sulphate == 1
cheat hush
cheat set F_RECIPE
cheat hold sprayer
press A
expect mix == 1
expect has_sulphate == 0
cheat hush
cheat hold sprayer
press RIGHT
press A
expect mix == 3
cheat hush
cheat hold sprayer
press RIGHT
press A
expect has_mixture == 1
expect has_sprayer == 0
expect has_water == 0
expect slotof_mixture == 0
