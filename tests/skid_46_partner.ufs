# SKID KIDS: your partner, by default, only fetches bags. It never passes
# one over by itself: it holds it in the corner of your half away from you
# until the forced throw, and the bag is yours to swap to (swapping over and
# straight back tosses it across as you swap). It won't walk to a bag lying
# in the way of a throw coming over. With the house rule it plays on its own.
seed 28
game skidkids
wait 5
cheat match 0 1 3 11 0
cheat coach 0
cheat clearbags
cheat freeze 2
cheat freeze 3
cheat play
cheat kid 0 130 60
cheat kid 1 60 150
cheat loose 40 120
waituntil held1 == 1 200
wait 200
# it kept it: no pass, and it waits in its corner, away from you
expect n_pass == 0
expect held0 == 0
expect held1 == 1
expect n_throw == 0
expect ky1 > 130
expect kx1 < 60
# swap over to it and straight back: the bag comes across as you swap
press B
expect ctrl0 == 1
press B
expect ctrl0 == 0
expect n_pass == 1
waituntil held0 == 1 60
expect held1 == 0
# a bag it holds too long throws itself
cheat give 1 1
cheat hold 1 290
wait 15
expect n_forced == 1
expect held1 == 0
# a loose bag in the lane of a throw coming over: it stays away from it
cheat clearbags
cheat kid 0 60 164
cheat kid 1 60 100
cheat loose 110 150
cheat bag 300 150 -3.8 0 1 0
wait 30
expect held1 == 0
expect ky1 < 100
expect kx1 < 64
# once the throw has gone by, it fetches again
waituntil held1 == 1 300
# the house rule: it plays on its own and throws
cheat clearbags
cheat rules 15 5 1 1 0
cheat kid 1 60 100
cheat kid 2 250 100
cheat give 1 1
waituntil n_throw == 2 400
