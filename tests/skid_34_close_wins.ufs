# SKID KIDS: a win that isn't a blowout still counts for the Saucer but not
# for the Alien.
seed 15
game skidkids
wait 5
cheat tourney 3 7
botuntil state == 7 800
cheat score 0 12
cheat win 0
wait 160
expect result_blowout == 0
expect result_close == 0
expect blowouts == 0
botuntil state == 7 800
cheat win 0
wait 160
botuntil state == 7 800
cheat win 0
wait 160
botuntil state == 7 800
cheat win 0
wait 160
botuntil state == 7 800
cheat win 0
wait 160
botuntil state == 7 800
cheat win 0
wait 160
expect wins == 6
expect goals == 3
