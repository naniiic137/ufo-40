# BANNERFALL: the pikeman hits two tiles ahead (through allies), the rider
# moves twice when the way is clear, the shade throws knives up and down and
# still marches.
game bannerfall
wait 5
cheat battle 18
cheat clear
cheat unit 2 0 5 0
cheat unit 3 0 3 0
cheat unit 4 0 1 1
cheat resolve
expect hp_at40 == 2
expect hp_at30 == 4
expect unit_at20 == 5
# rider
cheat clear
cheat unit 1 2 4 0
cheat unit 1 4 4 0
cheat unit 4 4 3 1
cheat resolve
expect unit_at32 == 4
expect unit_at24 == 4
expect unit_at34 == 3
# shade: a knife up hits the foe; down, a friend is in the way
cheat clear
cheat unit 3 2 6 0
cheat unit 3 0 1 1
cheat unit 3 4 3 0
cheat unit 3 5 1 1
cheat resolve
expect unit_at42 == 6
expect hp_at20 == 2
expect hp_at25 == 3
# nothing in between: the knife flies to the foe at the far end
cheat clear
cheat unit 3 0 6 0
cheat unit 3 5 1 1
cheat resolve
expect hp_at25 == 2
expect unit_at40 == 6
