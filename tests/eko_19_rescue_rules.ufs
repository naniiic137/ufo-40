# THE JAILBREAK: every step is a turn, then every guard takes its turn.
# Crates push like a block puzzle. A guard sees straight along the way it
# faces (crates and other guards block it); seen, it comes for the bat and
# strikes when next to it. Bumping a wall is no turn at all.
seed 1
game echounit
wait 5
cheat rescue 1 3 5
cheat rblank
wait 2
expect mode == 5
expect r_owl == 3
expect r_hp == 2
# a crate pushed along
cheat rtile 4 4 111
press RIGHT 1
wait 1
press RIGHT 1
wait 1
expect r_x == 4
expect r_turns == 2
expect r_tile_5_4 == 111

# into the wall: no turn
cheat rpos 1 1
press UP 1
wait 1
expect r_turns == 2
expect r_tile_5_4 == 111
# a sentry looking along row 1 sees the bat, comes, and strikes (she
# whistles to pass the turns)
cheat rguard 0 8 1 2
press DOWN 1
wait 1
press UP 1
wait 1
expect r_alert == 1
press B 1
wait 1
press B 1
wait 1
press B 1
wait 1
press B 1
wait 1
press B 1
wait 1
press B 1
wait 1
press B 1
wait 1
press B 1
wait 1
press B 1
wait 1
press B 1
wait 1
expect r_hp < 2
