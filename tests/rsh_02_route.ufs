# RIMSHIRE: the board. Each d-pad press moves the banner a space at once;
# the first turn of a war is a single space, later turns two; every move is
# used before the turn passes; a banner can't step back onto its own trail.
game rimshire
cheat war 1
wait 5
expect turn == 0
expect moves == 1
expect first_move == 1
press LEFT
wait 12
expect nx0 == 0
expect turn == 0
press RIGHT
waituntil turn == 1 60
expect nx0 == 1
expect trail0 == 2
# the Plum banner moves its two spaces
waituntil turn == 0 200
expect first_move == 0
expect moves == 2
expect nx1 == 10
expect trail1 == 3
# a step, and the inn's menu on the way
press RIGHT
waituntil wstate == 2 60
expect nx0 == 2
expect moves_used == 1
press B
waituntil wstate == 0 60
expect turn == 0
# no stepping back onto the trail
press LEFT
wait 12
expect nx0 == 2
expect moves_used == 1
press RIGHT
waituntil turn == 1 60
expect nx0 == 3
expect trail0 == 4
