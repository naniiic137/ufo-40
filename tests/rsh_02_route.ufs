# RIMSHIRE: the board. The d-pad draws the route a space at a time; the
# first move of a war is a single space, later turns two; the way back
# undoes a planned step; a route can't double back or cross itself; A goes
# only once every move is used.
game rimshire
cheat war 1
wait 5
expect turn == 0
expect moves == 1
expect first_move == 1
press LEFT
expect plan_n == 0
press RIGHT
expect plan_n == 1
expect plan_ready == 1
press RIGHT
expect plan_n == 1
press LEFT
expect plan_n == 0
press RIGHT
press A
waituntil turn == 1 60
expect nx0 == 1
expect trail0 == 2
# the Plum banner moves its two spaces
waituntil turn == 0 200
expect first_move == 0
expect moves == 2
expect nx1 == 10
expect trail1 == 3
# two moves: through the inn (its menu opens on the way) and on
press RIGHT
press RIGHT
expect plan_n == 2
expect plan_ready == 1
press A
waituntil wstate == 2 60
expect nx0 == 2
press B
waituntil turn == 1 60
expect nx0 == 3
expect trail0 == 4
waituntil turn == 0 300
# no doubling back onto the route
press LEFT
expect plan_n == 0
# one move of two can't be sent
press RIGHT
expect plan_n == 1
expect plan_ready == 0
press A
wait 5
expect wstate == 0
expect turn == 0
